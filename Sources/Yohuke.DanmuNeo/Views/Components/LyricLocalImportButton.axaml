<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Yohuke.DanmuNeo.Views.Components.LyricLocalImportButton"
             x:CompileBindings="False"
             x:Name="Root">
    <Button Classes.iconButton="{Binding #Root.IsCompact}"
            ToolTip.Tip="{Loc Key=UI.LyricLocalImportButton.ImportLocalLyrics}"
            AutomationProperties.Name="{Loc Key=UI.LyricLocalImportButton.ImportLocalLyrics}"
            Click="ImportLocalLyricFile_OnClick">
        <StackPanel Orientation="Horizontal"
                    Spacing="6">
            <LucideIcon Kind="FileInput"/>
            <TextBlock Text="{Loc Key=UI.LyricLocalImportButton.ImportLocalLyrics}"
                       IsVisible="{Binding !IsCompact, ElementName=Root}"/>
        </StackPanel>
    </Button>
</UserControl>
