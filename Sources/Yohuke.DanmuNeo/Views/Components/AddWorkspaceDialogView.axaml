<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Yohuke.DanmuNeo.ViewModels"
             xmlns:workspace="using:Yohuke.DanmuNeo.Models.Workspace"
             x:Class="Yohuke.DanmuNeo.Views.Components.AddWorkspaceDialogView"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="False"
             x:Name="Root">
    <Border x:Name="DialogSurface"
            Background="{DynamicResource AppCardBrush}"
            Padding="22"
            IsVisible="{Binding IsAddDialogOpen}">
        <Grid RowDefinitions="Auto,*,Auto"
              RowSpacing="14">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding AddDialogTitle}"
                           FontSize="26"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding AddDialogDescription}"
                           Classes="muted"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          AllowAutoHide="False"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBox Watermark="{Loc Key=UI.AddWorkspaceDialogView.Name}"
                             Text="{Binding NewWorkspaceName}"
                             IsVisible="{Binding IsAddingWorkspace}" />

                    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                          RowSpacing="10"
                          IsVisible="{Binding IsAddingRoom}">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                            <TextBox x:Name="LiveRoomSearchTextBox"
                                     Watermark="{Loc Key=UI.AddWorkspaceDialogView.SearchStreamer}"
                                     Text="{Binding LiveRoomSearchText}"
                                     KeyDown="LiveRoomSearch_OnKeyDown" />
                            <Button Grid.Column="1"
                                    Content="{Loc Key=UI.AddWorkspaceDialogView.Search}"
                                    Command="{Binding SearchLiveRoomsCommand}" />
                        </Grid>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding LiveRoomSearchStatus}"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                        <StackPanel Grid.Row="2" Spacing="8">
                            <ScrollViewer MaxHeight="240"
                                          AllowAutoHide="False"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="LiveRoomSearchResultsControl"
                                              ItemsSource="{Binding LiveRoomSearchResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="workspace:LiveRoomSearchResult">
                                            <Border Margin="0,0,0,8"
                                                    Padding="10"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                                    CornerRadius="8">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="{Binding OwnerName}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Title}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding DetailLine}"
                                                                   Classes="muted" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            x:Name="AddSearchedRoomButton"
                                                            Classes="primaryButton"
                                                            Content="{Loc Key=UI.AddWorkspaceDialogView.Add}"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding #Root.DataContext.AddSearchedRoomCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button Content="{Loc Key=UI.AddWorkspaceDialogView.LoadMore}"
                                    HorizontalAlignment="Center"
                                    IsVisible="{Binding HasMoreLiveRoomSearchResults}"
                                    Command="{Binding LoadMoreLiveRoomsCommand}" />
                        </StackPanel>
                        <Expander Grid.Row="3" Header="{Loc Key=UI.AddWorkspaceDialogView.AddRoomManually}">
                            <StackPanel Spacing="10" Margin="0,10,0,0">
                                <TextBox Watermark="{Loc Key=UI.AddWorkspaceDialogView.RoomName}"
                                         Text="{Binding NewRoomName}" />
                                <TextBox Watermark="{Loc Key=UI.AddWorkspaceDialogView.RoomId}"
                                         Text="{Binding NewRoomId}" />
                                <TextBox Watermark="{Loc Key=UI.AddWorkspaceDialogView.OptionalStreamerUid}"
                                         Text="{Binding NewRoomOwnerUid}" />
                            </StackPanel>
                        </Expander>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2"
                  ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="8">
                <TextBlock Text="{Binding AddDialogWorkspaceName}"
                           Classes="muted"
                           VerticalAlignment="Center"
                           IsVisible="{Binding IsAddingRoom}" />
                <Button Grid.Column="1"
                        Content="{Loc Key=UI.AddWorkspaceDialogView.Cancel}"
                        Command="{Binding #Root.CloseAddDialogCommand}" />
                <Button Grid.Column="2"
                        Classes="primaryButton"
                        Content="{Binding AddDialogPrimaryText}"
                        IsEnabled="{Binding !IsAddingRoomToWorkspace}"
                        Command="{Binding #Root.ConfirmAddDialogCommand}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
