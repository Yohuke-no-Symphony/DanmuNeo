<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:Yohuke.DanmuNeo.Views.Components"
             x:Class="Yohuke.DanmuNeo.Views.Components.SettingsConfigContainerView"
             x:CompileBindings="False">
    <ScrollViewer>
        <Grid Classes="scrollSafeContent">
            <components:GlobalSettingsView/>
            <components:AccountSettingsView/>
            <components:LyricLibrarySettingsView/>
            <components:MarkSymbolSettingsView/>
            <components:ShieldReplacementSettingsView/>
            <components:ShortcutSettingsView/>
            <components:MiscSettingsView/>
        </Grid>
    </ScrollViewer>
</UserControl>
