<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:items="clr-namespace:Yohuke.DanmuNeo.ViewModels.Items"
             xmlns:state="clr-namespace:Yohuke.DanmuNeo.Models.State"
             x:Class="Yohuke.DanmuNeo.Views.Components.GlobalSettingsView"
             x:CompileBindings="False"
             x:Name="Root">
    <StackPanel Spacing="18"
                IsVisible="{Binding IsGlobalSettingsSelected}">
        <Border Classes="panel" Padding="14">
            <StackPanel Spacing="12">
                <TextBlock Text="{Loc Key=Settings.Appearance.Title}"
                           Classes="sectionTitle"/>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="InterfaceLanguageLabel"
                               Text="{Loc Key=Settings.Language.Label}"
                               Classes="muted"/>
                    <ComboBox x:Name="InterfaceLanguageChoice"
                              ItemsSource="{Binding LanguageOptions}"
                              SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"
                              AutomationProperties.Name="{Loc Key=Settings.Language.Label}">
                        <ComboBox.Styles>
                            <Style Selector="ComboBoxItem">
                                <Setter Property="IsEnabled" Value="{Binding IsAvailable}"/>
                            </Style>
                        </ComboBox.Styles>
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="items:LanguageOption">
                                <TextBlock Text="{Binding LanguageName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <ItemsControl x:Name="ThemeModeChoices"
                              ItemsSource="{Binding ThemeModeOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"
                                       ItemSpacing="16"
                                       LineSpacing="16"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="items:ThemeModeOption">
                            <Button Classes="themeCardButton"
                                    MaxWidth="{Binding #ThemeModeChoices.Bounds.Width}"
                                    Classes.selected="{Binding IsSelected}"
                                    Command="{Binding #Root.SelectThemeModeCommand}"
                                    CommandParameter="{Binding}">
                                <StackPanel Spacing="10">
                                    <Border Classes="themePreview"
                                            Classes.systemPreview="{Binding IsSystemPreview}"
                                            Classes.lightPreview="{Binding IsLightPreview}"
                                            Classes.darkPreview="{Binding IsDarkPreview}">
                                        <Grid RowDefinitions="*,*"
                                              ColumnDefinitions="*,*">
                                            <Border Classes="themePreviewPane leftTop"/>
                                            <Border Grid.Column="1"
                                                    Classes="themePreviewPane rightTop"/>
                                            <Border Grid.Row="1"
                                                    Grid.ColumnSpan="2"
                                                    Classes="themePreviewContent">
                                                <StackPanel Spacing="6"
                                                            Margin="12">
                                                    <Border Classes="themePreviewLine wide"/>
                                                    <Border Classes="themePreviewLine"/>
                                                    <Border Classes="themePreviewLine short"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox Content="{Loc Key=Settings.Appearance.WindowMenuOnMac}"
                          IsVisible="{Binding IsMacOS}"
                          IsChecked="{Binding UseWindowMenuOnMac}" />
            </StackPanel>
        </Border>

        <Border Classes="panel" Padding="14">
            <StackPanel Spacing="10">
                <TextBlock Text="{Loc Key=UI.GlobalSettingsView.DanmuSettings}"
                           Classes="sectionTitle" />
                <CheckBox Content="{Loc Key=UI.GlobalSettingsView.CompactDanmu}"
                          IsChecked="{Binding IsCompactDanmuDisplay}" />
                <StackPanel Margin="16,0,0,0"
                            Spacing="8"
                            IsEnabled="{Binding IsCompactDanmuDisplay}">
                    <CheckBox x:Name="CompactDanmuWrapCheckBox"
                              Content="{Loc Key=UI.GlobalSettingsView.WrapDanmu}"
                              IsChecked="{Binding IsCompactDanmuWrap}" />
                    <CheckBox x:Name="CompactSuperChatWrapCheckBox"
                              Content="{Loc Key=UI.GlobalSettingsView.WrapSuperChat}"
                              IsChecked="{Binding IsCompactSuperChatWrap}" />
                </StackPanel>
                <TextBlock Text="{Loc Key=UI.GlobalSettingsView.LooseModeWrappingHint}"
                           Classes="muted"
                           TextWrapping="Wrap" />
                <CheckBox Content="{Loc Key=UI.GlobalSettingsView.BlockEmoticonDanmu}"
                          IsChecked="{Binding IsHideEmoticonDanmu}" />
            </StackPanel>
        </Border>

        <Border Classes="panel" Padding="14">
            <StackPanel Spacing="10">
                <TextBlock Text="{Loc Key=UI.GlobalSettingsView.GlobalSending}"
                           Classes="sectionTitle"/>
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Loc Key=UI.GlobalSettingsView.SendInterval}"
                                   Classes="muted"/>
                        <TextBox Watermark="{Loc Key=UI.GlobalSettingsView.SendInterval}"
                                 Text="{Binding Settings.SendIntervalMs}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Spacing="4">
                        <TextBlock Text="{Loc Key=UI.GlobalSettingsView.TimeoutSeconds}"
                                   Classes="muted"/>
                        <TextBox x:Name="TimeoutSecondsInput"
                                 Watermark="{Loc Key=UI.GlobalSettingsView.TimeoutSeconds}"
                                 Text="{Binding Settings.TimeoutSeconds}"/>
                    </StackPanel>
                </Grid>
                <WrapPanel x:Name="GlobalSendingOptions"
                           Orientation="Horizontal"
                           ItemSpacing="16"
                           LineSpacing="8">
                    <CheckBox Content="{Loc Key=UI.GlobalSettingsView.EnableReplacements}"
                              IsChecked="{Binding Settings.EnableShieldProcessing}"/>
                    <CheckBox Content="{Loc Key=UI.GlobalSettingsView.RetryBlockedMessages}"
                              IsChecked="{Binding Settings.ResendWhenShielded}"/>
                    <CheckBox Content="{Loc Key=UI.GlobalSettingsView.AutoListenOnPlayback}"
                              IsChecked="{Binding Settings.AutoStartListeningWithLivePlayer}"/>
                </WrapPanel>
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Loc Key=UI.GlobalSettingsView.FeedInsertPrefix}"
                                   Classes="muted"/>
                        <TextBox Watermark="{Loc Key=UI.GlobalSettingsView.FeedInsertPrefix}"
                                 Text="{Binding Settings.DanmuInsertOpenMark}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Spacing="4">
                        <TextBlock Text="{Loc Key=UI.GlobalSettingsView.FeedInsertSuffix}"
                                   Classes="muted"/>
                        <TextBox Watermark="{Loc Key=UI.GlobalSettingsView.FeedInsertSuffix}"
                                 Text="{Binding Settings.DanmuInsertCloseMark}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Loc Key=UI.GlobalSettingsView.FeedInsertionExample}"
                           Classes="muted"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
