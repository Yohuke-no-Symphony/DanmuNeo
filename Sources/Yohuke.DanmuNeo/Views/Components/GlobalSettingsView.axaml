<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:items="clr-namespace:Yohuke.DanmuNeo.ViewModels.Items"
             xmlns:state="clr-namespace:Yohuke.DanmuNeo.Models.State"
             x:Class="Yohuke.DanmuNeo.Views.Components.GlobalSettingsView"
             x:CompileBindings="False"
             x:Name="Root">
    <StackPanel Spacing="18"
                IsVisible="{Binding IsGlobalSettingsSelected}">
        <Border Classes="panel" Padding="14">
            <StackPanel Spacing="12">
                <TextBlock Text="外观"
                           Classes="sectionTitle"/>
                <ItemsControl x:Name="ThemeModeChoices"
                              ItemsSource="{Binding ThemeModeOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"
                                       ItemSpacing="16"
                                       LineSpacing="16"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="items:ThemeModeOption">
                            <Button Classes="themeCardButton"
                                    MaxWidth="{Binding #ThemeModeChoices.Bounds.Width}"
                                    Classes.selected="{Binding IsSelected}"
                                    Command="{Binding #Root.SelectThemeModeCommand}"
                                    CommandParameter="{Binding}">
                                <StackPanel Spacing="10">
                                    <Border Classes="themePreview"
                                            Classes.systemPreview="{Binding IsSystemPreview}"
                                            Classes.lightPreview="{Binding IsLightPreview}"
                                            Classes.darkPreview="{Binding IsDarkPreview}">
                                        <Grid RowDefinitions="*,*"
                                              ColumnDefinitions="*,*">
                                            <Border Classes="themePreviewPane leftTop"/>
                                            <Border Grid.Column="1"
                                                    Classes="themePreviewPane rightTop"/>
                                            <Border Grid.Row="1"
                                                    Grid.ColumnSpan="2"
                                                    Classes="themePreviewContent">
                                                <StackPanel Spacing="6"
                                                            Margin="12">
                                                    <Border Classes="themePreviewLine wide"/>
                                                    <Border Classes="themePreviewLine"/>
                                                    <Border Classes="themePreviewLine short"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox Content="在窗口内显示菜单（macOS）"
                          IsVisible="{Binding IsMacOS}"
                          IsChecked="{Binding UseWindowMenuOnMac}" />
            </StackPanel>
        </Border>

        <Border Classes="panel" Padding="14">
            <StackPanel Spacing="10">
                <TextBlock Text="弹幕设置"
                           Classes="sectionTitle" />
                <CheckBox Content="紧凑弹幕显示"
                          IsChecked="{Binding IsCompactDanmuDisplay}" />
                <StackPanel Margin="16,0,0,0"
                            Spacing="8"
                            IsEnabled="{Binding IsCompactDanmuDisplay}">
                    <CheckBox x:Name="CompactDanmuWrapCheckBox"
                              Content="弹幕自动换行"
                              IsChecked="{Binding IsCompactDanmuWrap}" />
                    <CheckBox x:Name="CompactSuperChatWrapCheckBox"
                              Content="SC 自动换行"
                              IsChecked="{Binding IsCompactSuperChatWrap}" />
                </StackPanel>
                <TextBlock Text="宽松模式始终自动换行。"
                           Classes="muted"
                           TextWrapping="Wrap" />
                <CheckBox Content="屏蔽表情弹幕"
                          IsChecked="{Binding IsHideEmoticonDanmu}" />
            </StackPanel>
        </Border>

        <Border Classes="panel" Padding="14">
            <StackPanel Spacing="10">
                <TextBlock Text="全局发送"
                           Classes="sectionTitle"/>
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="发送间隔 ms"
                                   Classes="muted"/>
                        <TextBox Watermark="发送间隔 ms"
                                 Text="{Binding Settings.SendIntervalMs}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Spacing="4">
                        <TextBlock Text="超时秒数"
                                   Classes="muted"/>
                        <TextBox Watermark="超时秒数"
                                 Text="{Binding Settings.TimeoutSeconds}"/>
                    </StackPanel>
                </Grid>
                <WrapPanel x:Name="GlobalSendingOptions"
                           Orientation="Horizontal"
                           ItemSpacing="16"
                           LineSpacing="8">
                    <CheckBox Content="开启屏蔽词处理"
                              IsChecked="{Binding Settings.EnableShieldProcessing}"/>
                    <CheckBox Content="屏蔽时重发"
                              IsChecked="{Binding Settings.ResendWhenShielded}"/>
                    <CheckBox Content="播放/追帧时自动监听"
                              IsChecked="{Binding Settings.AutoStartListeningWithLivePlayer}"/>
                </WrapPanel>
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="弹幕/SC 插入开符号"
                                   Classes="muted"/>
                        <TextBox Watermark="弹幕/SC 插入开符号"
                                 Text="{Binding Settings.DanmuInsertOpenMark}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Spacing="4">
                        <TextBlock Text="弹幕/SC 插入闭符号"
                                   Classes="muted"/>
                        <TextBox Watermark="弹幕/SC 插入闭符号"
                                 Text="{Binding Settings.DanmuInsertCloseMark}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="示例：点击内容 你好，插入 &quot;你好&quot;"
                           Classes="muted"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
