<components:WorkbenchRoomPanel xmlns="https://github.com/avaloniaui"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:workspace="clr-namespace:Yohuke.DanmuNeo.Models.Workspace"
                               xmlns:state="clr-namespace:Yohuke.DanmuNeo.Models.State"
                               xmlns:components="clr-namespace:Yohuke.DanmuNeo.Views.Components"
                               xmlns:items="clr-namespace:Yohuke.DanmuNeo.ViewModels.Items"
                               xmlns:converters="using:Avalonia.Data.Converters"
                               x:Class="Yohuke.DanmuNeo.Views.Components.ForwardingPanelView"
                               x:DataType="items:LiveRoomTabViewModel"
                               x:CompileBindings="True"
                               x:Name="Root">
    <components:WorkbenchRoomPanel.Styles>
        <Style Selector="Border.forwardRuleCard">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="Border.forwardRuleCard.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource AppSidebarSelectedBrush}" />
        </Style>
        <Style Selector="Button.forwardDragHandle">
            <Setter Property="Width" Value="20" />
            <Setter Property="MinWidth" Value="20" />
            <Setter Property="Height" Value="{StaticResource WorkbenchControlHeight}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="SizeAll" />
        </Style>
        <Style Selector="Button.forwardDragHandle LucideIcon">
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
        </Style>
        <Style Selector="Button.forwardDragHandle.selected LucideIcon">
            <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.forwardEnabledToggle">
            <Setter Property="Width" Value="{StaticResource WorkbenchControlHeight}" />
            <Setter Property="Height" Value="{StaticResource WorkbenchControlHeight}" />
            <Setter Property="MinWidth" Value="{StaticResource WorkbenchControlHeight}" />
            <Setter Property="MinHeight" Value="{StaticResource WorkbenchControlHeight}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource WorkbenchControlCornerRadius}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.forwardEnabledToggle LucideIcon">
            <Setter Property="Size" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
        </Style>
        <Style Selector="ToggleButton.forwardEnabledToggle:checked">
            <Setter Property="Background" Value="{DynamicResource AppSidebarSelectedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.forwardEnabledToggle:checked LucideIcon">
            <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="ComboBox.forwardSelector">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="TextBox.forwardInput">
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style Selector="Border.forwardUserNameBadge">
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="Margin" Value="4,0,6,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{DynamicResource AppSidebarHoverBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.forwardClipboardStatus.error">
            <Setter Property="Foreground" Value="{DynamicResource AppErrorBrush}" />
        </Style>
    </components:WorkbenchRoomPanel.Styles>
    <Border Padding="{StaticResource WorkbenchPanelPadding}">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
                <TextBlock Text="{Loc Key=UI.ForwardingPanelView.RulesTitle}" Classes="sectionTitle" VerticalAlignment="Center"
                           ToolTip.Tip="{Loc Key=UI.ForwardingPanelView.RulesHint}" />
                <Border Grid.Column="1" Height="1" Margin="4,0"
                        VerticalAlignment="Center" Background="{DynamicResource AppBorderBrush}" />
                <Button x:Name="ForwardCopyButton" Grid.Column="2" Classes="iconButton"
                        ToolTip.Tip="{Loc Key=UI.ForwardingPanelView.CopyRulesHint}" AutomationProperties.Name="{Loc Key=UI.ForwardingPanelView.CopyRules}"
                        Click="CopyForwardRules_OnClick">
                    <LucideIcon Kind="Copy" />
                </Button>
                <Button x:Name="ForwardPasteButton" Grid.Column="3" Classes="iconButton"
                        ToolTip.Tip="{Loc Key=UI.ForwardingPanelView.PasteRulesHint}" AutomationProperties.Name="{Loc Key=UI.ForwardingPanelView.PasteRules}"
                        Click="PasteForwardRules_OnClick">
                    <LucideIcon Kind="ClipboardPaste" />
                </Button>
                <Button x:Name="ForwardAddButton" Grid.Column="4" Classes="iconButton"
                        ToolTip.Tip="{Loc Key=UI.ForwardingPanelView.AddRule}" AutomationProperties.Name="{Loc Key=UI.ForwardingPanelView.AddRule}"
                        Command="{Binding AddForwardRuleCommand}">
                    <LucideIcon Kind="Plus" />
                </Button>
            </Grid>
            <TextBlock x:Name="ForwardClipboardStatus" Grid.Row="1" IsVisible="False"
                       Classes="muted forwardClipboardStatus" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <ScrollViewer x:Name="ForwardRulesScrollViewer" Grid.Row="2"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ForwardRulesItems" Classes="scrollSafeContent"
                              ItemsSource="{Binding ForwardRules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="items:DanmuForwardRuleViewModel">
                            <Grid Margin="0,0,0,8">
                                <Border x:Name="ForwardRuleCard" Classes="forwardRuleCard">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="6">
                                            <Button x:Name="ForwardDragHandle" Classes="forwardDragHandle"
                                                    ToolTip.Tip="{Loc Key=UI.ForwardingPanelView.SelectOrDragHint}" AutomationProperties.Name="{Loc Key=UI.ForwardingPanelView.SelectOrDrag}"
                                                    Click="ForwardDragHandle_OnClick" KeyDown="ForwardDragHandle_OnKeyDown"
                                                    PointerCaptureLost="ForwardDragHandle_OnPointerCaptureLost">
                                                <LucideIcon Kind="GripVertical" />
                                            </Button>
                                            <ToggleButton x:Name="ForwardEnabledToggle" Grid.Column="1"
                                                          Classes="forwardEnabledToggle" IsChecked="{Binding IsEnabled}"
                                                          ToolTip.Tip="{Loc Key=UI.ForwardingPanelView.ToggleRuleHint}" AutomationProperties.Name="{Loc Key=UI.ForwardingPanelView.EnableRule}">
                                                <LucideIcon Kind="Power" />
                                            </ToggleButton>
                                            <ComboBox x:Name="ForwardSourceRoomSelector" Grid.Column="2" Classes="forwardSelector"
                                                      AutomationProperties.Name="{Loc Key=UI.ForwardingPanelView.SourceRoom}"
                                                      ItemsSource="{Binding SourceRoomOptions}" SelectedValue="{Binding SourceRoomKey}"
                                                      SelectedValueBinding="{Binding Key}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="workspace:ForwardSourceRoomOption">
                                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button x:Name="ForwardCopyRuleButton" Grid.Column="3" Classes="iconButton"
                                                    ToolTip.Tip="{Loc Key=UI.ForwardingPanelView.CopyRuleHint}" AutomationProperties.Name="{Loc Key=UI.ForwardingPanelView.CopyRule}"
                                                    Click="CopyForwardRule_OnClick">
                                                <LucideIcon Kind="Copy" />
                                            </Button>
                                            <Button x:Name="ForwardDeleteRuleButton" Grid.Column="4" Classes="iconButton"
                                                    ToolTip.Tip="{Loc Key=UI.ForwardingPanelView.DeleteRuleHint}" AutomationProperties.Name="{Loc Key=UI.ForwardingPanelView.DeleteRule}"
                                                    Command="{Binding #Root.Context.CurrentRoom.RemoveForwardRuleCommand}"
                                                    CommandParameter="{Binding}">
                                                <LucideIcon Kind="Trash2" />
                                            </Button>
                                        </Grid>
                                        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="6">
                                            <TextBox x:Name="ForwardUidInput" Classes="forwardInput"
                                                     Watermark="{Loc Key=UI.ForwardingPanelView.SenderUid}" Text="{Binding SenderUid}"
                                                     AutomationProperties.Name="{Loc Key=UI.ForwardingPanelView.ForwardSenderUid}" SizeChanged="ForwardUidInput_OnSizeChanged">
                                                <TextBox.InnerRightContent>
                                                    <Border x:Name="ForwardUserNameBadge" Classes="forwardUserNameBadge" MaxWidth="100"
                                                            IsVisible="{Binding SenderUserNameDisplayText, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}">
                                                        <TextBlock x:Name="ForwardSenderUserNameText" Classes="muted"
                                                                   Text="{Binding SenderUserNameDisplayText}"
                                                                   ToolTip.Tip="{Binding SenderUserNameDisplayText}"
                                                                   FontSize="{DynamicResource AppFontSizeCaption}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </TextBox.InnerRightContent>
                                            </TextBox>
                                            <TextBox x:Name="ForwardPatternInput" Grid.Column="1" Classes="forwardInput"
                                                     Watermark="{Loc Key=UI.ForwardingPanelView.ContentPattern}" Text="{Binding ContentPattern}"
                                                     ToolTip.Tip="{Loc Key=UI.ForwardingPanelView.ContentPatternHint}" AutomationProperties.Name="{Loc Key=UI.ForwardingPanelView.ForwardContentPattern}" />
                                        </Grid>
                                        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="6">
                                            <ComboBox x:Name="ForwardAccountSelector" Classes="forwardSelector"
                                                      ToolTip.Tip="{Loc Key=UI.ForwardingPanelView.SenderAccount}" AutomationProperties.Name="{Loc Key=UI.ForwardingPanelView.SenderAccount}"
                                                      ItemsSource="{Binding AccountOptions}" SelectedValue="{Binding AccountOverrideId}"
                                                      SelectedValueBinding="{Binding AccountId}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="items:ForwardAccountOption">
                                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <ComboBox x:Name="ForwardSymbolSelector" Grid.Column="1" Classes="forwardSelector"
                                                      ToolTip.Tip="{Loc Key=UI.ForwardingPanelView.PrefixSuffixHint}" AutomationProperties.Name="{Loc Key=UI.ForwardingPanelView.SymbolGroup}"
                                                      ItemsSource="{Binding SymbolGroups}" SelectedValue="{Binding MarkSymbolGroupId}"
                                                      SelectedValueBinding="{Binding Id}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="state:MarkSymbolGroup">
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                        <TextBlock x:Name="ForwardRuleStatusText" Grid.Row="3" Classes="muted"
                                                   Text="{Binding StatusText}" ToolTip.Tip="{Binding StatusText}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                                <Border x:Name="ForwardDropIndicator" Height="2" Margin="0,-4,0,-4"
                                        Background="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Top"
                                        IsVisible="False" IsHitTestVisible="False" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</components:WorkbenchRoomPanel>
