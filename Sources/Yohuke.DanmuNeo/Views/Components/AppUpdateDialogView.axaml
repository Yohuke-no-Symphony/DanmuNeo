<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Yohuke.DanmuNeo.Views.Components.AppUpdateDialogView"
             x:CompileBindings="False"
             x:Name="Root">
    <Border Classes="addDialogOverlay"
            IsVisible="{Binding IsUpdateDialogOpen}">
        <Border Classes="addDialogPanel">
            <StackPanel Spacing="18">
                <StackPanel Spacing="8">
                    <TextBlock Text="发现新版本"
                               FontSize="24"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding AvailableUpdate.TagName, StringFormat='最新版本：{0}'}"
                               FontSize="16"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding AppVersion, StringFormat='当前版本：{0}'}"
                               Classes="muted"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="前往 GitHub 发布页面查看更新说明并下载。"
                               Classes="muted"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="LaunchErrorText"
                           Text="无法打开浏览器，请稍后重试。"
                           Classes="muted"
                           IsVisible="False"
                           TextWrapping="Wrap"/>
                <Grid ColumnDefinitions="*,Auto,Auto"
                      ColumnSpacing="8">
                    <Button x:Name="DismissUpdateButton"
                            Grid.Column="1"
                            Content="稍后"
                            Command="{Binding CloseUpdateDialogCommand}"/>
                    <Button x:Name="OpenReleaseButton"
                            Grid.Column="2"
                            Classes="primaryButton"
                            Content="前往 GitHub"
                            Command="{Binding #Root.OpenReleaseCommand}"/>
                </Grid>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
