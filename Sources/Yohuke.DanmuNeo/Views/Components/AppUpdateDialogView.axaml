<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Yohuke.DanmuNeo.Views.Components.AppUpdateDialogView"
             x:CompileBindings="False"
             x:Name="Root">
    <Border x:Name="DialogSurface"
            Background="{DynamicResource AppCardBrush}"
            Padding="24"
            IsVisible="{Binding IsUpdateDialogOpen}">
        <StackPanel Spacing="18">
            <StackPanel Spacing="8">
                <TextBlock x:Name="UpdateMessageText"
                           Text="{Binding UpdateCheckMessage}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
                <TextBlock x:Name="LatestVersionText"
                           IsVisible="{Binding !!AvailableUpdate}"
                           FontSize="16"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
                <TextBlock x:Name="CurrentVersionText"
                           Classes="muted"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
                <TextBlock Text="{Loc Key=UI.AppUpdateDialogView.ReleaseHint}"
                           IsVisible="{Binding !!AvailableUpdate}"
                           Classes="muted"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="LaunchErrorText"
                       Text="{Loc Key=UI.AppUpdateDialogView.BrowserLaunchFailed}"
                       Classes="muted"
                       IsVisible="False"
                       TextWrapping="Wrap"/>
            <Grid ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="8">
                <Button x:Name="DismissUpdateButton"
                        Grid.Column="1"
                        Content="{Loc Key=UI.AppUpdateDialogView.Close}"
                        Command="{Binding CloseUpdateDialogCommand}"/>
                <Button x:Name="OpenReleaseButton"
                        Grid.Column="2"
                        Classes="primaryButton"
                        Content="{Loc Key=UI.AppUpdateDialogView.OpenGitHub}"
                        IsVisible="{Binding !!AvailableUpdate}"
                        Command="{Binding #Root.OpenReleaseCommand}"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
