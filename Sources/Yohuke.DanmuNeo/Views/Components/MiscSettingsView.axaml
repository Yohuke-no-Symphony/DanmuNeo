<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Yohuke.DanmuNeo.Views.Components.MiscSettingsView"
             x:CompileBindings="False"
             x:Name="Root">
    <StackPanel Spacing="14"
                IsVisible="{Binding IsMiscSettingsSelected}">
        <Border Classes="panel" Padding="14">
            <StackPanel Spacing="10">
                <TextBlock Text="{Loc Key=UI.MiscSettingsView.AppInformation}"
                           Classes="sectionTitle"/>
                <Grid ColumnDefinitions="120,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="8">
                    <TextBlock Text="{Loc Key=UI.MiscSettingsView.CurrentVersion}"
                               Classes="muted"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding AppVersion}"/>
                    <TextBlock Grid.Row="1"
                               Text="{Loc Key=UI.MiscSettingsView.ConfigurationDirectory}"
                               Classes="muted"/>
                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             IsReadOnly="True"
                             Text="{Binding ConfigDirectory}"/>
                </Grid>
                <CheckBox x:Name="CheckForUpdatesOnStartupCheckBox"
                          Content="{Loc Key=UI.MiscSettingsView.CheckUpdatesAtStartup}"
                          IsChecked="{Binding CheckForUpdatesOnStartup, Mode=TwoWay}"/>
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <Button Command="{Binding #Root.OpenConfigDirectoryCommand}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <LucideIcon Kind="FolderOpen"/>
                            <TextBlock Text="{Loc Key=UI.MiscSettingsView.OpenConfigurationDirectory}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="primaryButton"
                            Command="{Binding #Root.ExportAllBackupCommand}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <LucideIcon Kind="Archive"/>
                            <TextBlock Text="{Loc Key=UI.MiscSettingsView.ExportAllBackups}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Text="{Binding LastBackupPath}"
                           Classes="muted"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasLastBackupPath}"/>
                <Grid ColumnDefinitions="120,*"
                      ColumnSpacing="12"
                      RowSpacing="8">
                    <TextBlock Text="{Loc Key=UI.MiscSettingsView.AutomaticBackups}"
                               Classes="muted"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1"
                                Spacing="4">
                        <TextBox Width="120"
                                 HorizontalAlignment="Left"
                                 Watermark="10"
                                 Text="{Binding Settings.BackupRetentionCount}"/>
                        <TextBlock Text="{Loc Key=UI.MiscSettingsView.BackupCountHint}"
                                   Classes="muted"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Classes="panel" Padding="14">
            <StackPanel Spacing="10">
                <TextBlock Text="{Loc Key=UI.MiscSettingsView.Cache}"
                           Classes="sectionTitle"/>
                <Grid ColumnDefinitions="120,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="8">
                    <TextBlock Text="{Loc Key=UI.MiscSettingsView.CacheDirectory}"
                               Classes="muted"/>
                    <TextBox Grid.Column="1"
                             IsReadOnly="True"
                             Text="{Binding CacheDirectory}"/>
                    <TextBlock Grid.Row="1"
                               Text="{Loc Key=UI.MiscSettingsView.CacheSize}"
                               Classes="muted"/>
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Text="{Binding CacheSizeText}"
                               VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <Button Command="{Binding #Root.RefreshCacheSizeCommand}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <LucideIcon Kind="RefreshCcw"/>
                            <TextBlock Text="{Loc Key=UI.MiscSettingsView.RefreshCacheSize}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding #Root.OpenCacheDirectoryCommand}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <LucideIcon Kind="FolderOpen"/>
                            <TextBlock Text="{Loc Key=UI.MiscSettingsView.OpenCacheDirectory}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding #Root.ClearCacheCommand}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <LucideIcon Kind="Trash2"/>
                            <TextBlock Text="{Loc Key=UI.MiscSettingsView.ClearCache}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
