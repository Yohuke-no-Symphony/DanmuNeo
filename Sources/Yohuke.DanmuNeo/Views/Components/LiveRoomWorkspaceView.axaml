<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:workspace="clr-namespace:Yohuke.DanmuNeo.Models.Workspace"
             xmlns:state="clr-namespace:Yohuke.DanmuNeo.Models.State"
             xmlns:components="clr-namespace:Yohuke.DanmuNeo.Views.Components"
             xmlns:items="clr-namespace:Yohuke.DanmuNeo.ViewModels.Items"
             x:Class="Yohuke.DanmuNeo.Views.Components.LiveRoomWorkspaceView"
             x:CompileBindings="False"
             x:Name="Root">
    <Design.DataContext>
        <items:LiveRoomTabViewModel />
    </Design.DataContext>

    <Grid x:Name="WorkspaceColumns">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="420" />
            <ColumnDefinition Width="2" />
            <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <Border Classes="panel"
                Padding="14">
            <Grid RowDefinitions="Auto,*,Auto"
                  RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="8">
                        <Border Classes="listenStatusLight"
                                Classes.listening="{Binding IsListening}"
                                Classes.idle="{Binding IsNotListening}"
                                ToolTip.Tip="{Binding ConnectionStatus}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding RoomName}"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding RoomId}"
                                       Classes="muted" />
                            <TextBlock Text="{Binding ModerationStatus}"
                                       Classes="muted"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Button Grid.Column="1"
                            Classes="listenToggleButton"
                            Classes.listening="{Binding IsListening}"
                            Classes.idle="{Binding IsNotListening}"
                            ToolTip.Tip="{Binding ConnectionStatus}"
                            Command="{Binding ToggleListeningCommand}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <LucideIcon Kind="Radio"
                                        IsVisible="{Binding IsNotListening}" />
                            <LucideIcon Kind="CircleStop"
                                        IsVisible="{Binding IsListening}" />
                            <TextBlock Text="{Binding ListenToggleText}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1"
                      RowDefinitions="Auto,*"
                      RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,120,42"
                          ColumnSpacing="8"
                          VerticalAlignment="Center">
                        <ComboBox Height="30"
                                  VerticalAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  ItemsSource="{Binding LiveQualityOptions}"
                                  SelectedItem="{Binding SelectedLiveQuality}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="workspace:LiveQualityOption">
                                    <TextBlock Text="{Binding Description}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1"
                                ToolTip.Tip="{Binding LivePlayerToggleToolTip}"
                                Classes="iconButton"
                                Classes.selected="{Binding IsLivePlayerVisible}"
                                VerticalAlignment="Center"
                                Command="{Binding ToggleLivePlayerCommand}">
                            <Grid>
                                <LucideIcon Kind="CirclePlay"
                                            IsVisible="{Binding IsLivePlayerHidden}" />
                                <LucideIcon Kind="CircleStop"
                                            IsVisible="{Binding IsLivePlayerVisible}" />
                            </Grid>
                        </Button>
                        <Button Grid.Column="2"
                                ToolTip.Tip="追帧"
                                Classes="iconButton"
                                VerticalAlignment="Center"
                                Command="{Binding ChaseLiveCommand}">
                            <LucideIcon Kind="RefreshCw" />
                        </Button>
                        <Button Grid.Column="3"
                                ToolTip.Tip="静音"
                                Classes="iconButton"
                                Classes.selected="{Binding IsLivePlayerMuted}"
                                VerticalAlignment="Center"
                                Command="{Binding ToggleLivePlayerMutedCommand}">
                            <Grid>
                                <LucideIcon Kind="Volume2"
                                            IsVisible="{Binding IsLivePlayerAudible}" />
                                <LucideIcon Kind="VolumeX"
                                            IsVisible="{Binding IsLivePlayerMuted}" />
                            </Grid>
                        </Button>
                        <Slider Grid.Column="4"
                                Minimum="0"
                                Maximum="100"
                                Value="{Binding LivePlayerVolumePercent}"
                                VerticalAlignment="Center"
                                ToolTip.Tip="音量" />
                        <TextBlock Grid.Column="5"
                                   Text="{Binding LivePlayerVolumeText}"
                                   Classes="muted"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Border x:Name="LivePlayerHost"
                                Classes="livePlayerSurface" />
                    </Grid>
                </Grid>

                <Border Grid.Row="2" Classes="translateComposer"
                        Classes.sendFailed="{Binding IsDraftSendFailed}">
                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="4">
                        <Grid>
                            <TextBox x:Name="InputDraftTextBox"
                                     Classes="translateComposerInput"
                                     Text="{Binding InputDraft}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="False"
                                     KeyDown="InputDraft_OnKeyDown" />
                            <TextBlock Text="输入同传内容"
                                       Classes="muted"
                                       IsHitTestVisible="False"
                                       IsVisible="{Binding IsInputDraftEmpty}" />
                        </Grid>
                        <Grid Grid.Row="1"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="10">
                            <ComboBox Classes="translateComposerMarkSelector"
                                      ItemsSource="{Binding DataContext.SymbolGroups, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding DataContext.SelectedWorkspaceMarkGroup, RelativeSource={RelativeSource AncestorType=Window}}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="state:MarkSymbolGroup">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1"
                                    Classes="translateComposerSendButton"
                                    ToolTip.Tip="发送同传"
                                    Command="{Binding SendDraftCommand}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <LucideIcon Kind="Send" />
                                    <TextBlock Text="发送" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1"
                      Width="2"
                      Classes="workspaceSplitter"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      PointerReleased="WorkspaceSplitter_OnPointerReleased" />

        <Grid Grid.Column="2">
            <Border Classes="panel"
                    Padding="14">
                <TabControl Classes="workspaceToolTabs">
                    <TabItem Header="弹幕">
                        <Grid Margin="0,10,0,0"
                              Classes.compactDanmu="{Binding DataContext.IsCompactDanmuDisplay, RelativeSource={RelativeSource AncestorType=Window}}"
                              Classes.compactDanmuWrap="{Binding DataContext.IsCompactDanmuWrap, RelativeSource={RelativeSource AncestorType=Window}}"
                              Classes.compactSuperChatWrap="{Binding DataContext.IsCompactSuperChatWrap, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35*" MinHeight="100" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="65*" MinHeight="160" />
                            </Grid.RowDefinitions>

                            <Grid RowDefinitions="*"
                                  RowSpacing="6">
                                <ListBox Grid.Row="0"
                                         Classes="feedList"
                                         ItemsSource="{Binding SuperChats}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="workspace:SuperChatItem">
                                            <Button Classes="scFeedButton"
                                                    Classes.guardPurchase="{Binding IsGuardPurchase}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Click="SuperChat_OnClick">
                                                <Border Classes="scFeedCard"
                                                        BorderThickness="2">
                                                    <Border.BorderBrush>
                                                        <SolidColorBrush Color="{Binding BorderColor}" />
                                                    </Border.BorderBrush>
                                                    <Grid Classes="scFeedLayout"
                                                          RowDefinitions="Auto,Auto">
                                                        <Grid ColumnDefinitions="*,Auto"
                                                              ColumnSpacing="8">
                                                            <StackPanel Spacing="1">
                                                                <Button Classes="feedUserNameButton"
                                                                        Click="FeedUserName_OnClick">
                                                                    <TextBlock Text="{Binding UserName}"
                                                                               Classes="danmuFeedUser"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </Button>
                                                                <TextBlock Text="{Binding DisplayTime}"
                                                                           Classes="danmuFeedMeta" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding BadgeText}"
                                                                       Classes="scFeedPrice"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Foreground>
                                                                    <SolidColorBrush Color="{Binding BorderColor}" />
                                                                </TextBlock.Foreground>
                                                            </TextBlock>
                                                        </Grid>
                                                        <Grid Grid.Row="1"
                                                              Classes="scFeedContent"
                                                              IsVisible="{Binding CanInsertContent}">
                                                            <TextBlock Text="{Binding Content}"
                                                                       Classes="danmuFeedContent regularFeedContent"
                                                                       TextWrapping="Wrap" />
                                                            <components:HoverMarqueeTextBlock
                                                                Text="{Binding Content}"
                                                                Classes="compactFeedContent" />
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                            <GridSplitter Grid.Row="1"
                                          Height="4"
                                          HorizontalAlignment="Stretch"
                                          ResizeDirection="Rows"
                                          ResizeBehavior="PreviousAndNext" />

                            <ScrollViewer x:Name="DanmuScrollViewer"
                                          Grid.Row="2"
                                          Margin="0,6,0,0">
                                <ItemsControl x:Name="DanmuItemsControl"
                                              Classes="scrollSafeContent"
                                              ItemsSource="{Binding DanmuItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="workspace:DanmuFeedItem">
                                            <Button Classes="danmuFeedButton"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    ContextRequested="Danmu_OnContextRequested"
                                                    Click="Danmu_OnClick">
                                                <Grid Classes="danmuFeedLayout"
                                                      ColumnDefinitions="2*,3*"
                                                      RowDefinitions="Auto,Auto">
                                                    <DockPanel Classes="danmuFeedIdentity"
                                                               VerticalAlignment="Center">
                                                        <Border Classes="danmuMedalBadge"
                                                                BorderBrush="{Binding MedalBorderBrush}"
                                                                IsVisible="{Binding HasMedal}"
                                                                ToolTip.Tip="{Binding MedalText}">
                                                            <Grid Classes="danmuMedalLayout"
                                                                  ColumnDefinitions="*,Auto">
                                                                <TextBlock Text="{Binding MedalDisplayName}"
                                                                           Classes="danmuMedalText danmuMedalName"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding MedalLevel}"
                                                                           Classes="danmuMedalText danmuMedalLevel"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                        </Border>
                                                        <Button Classes="feedUserNameButton"
                                                                Click="FeedUserName_OnClick">
                                                            <TextBlock Text="{Binding UserName}"
                                                                       Classes="danmuFeedUser"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Button>
                                                    </DockPanel>
                                                    <TextBlock Grid.Row="1"
                                                               Text="{Binding DetailLine}"
                                                               Classes="danmuFeedMeta"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Content}"
                                                               Classes="danmuFeedContent regularFeedContent"
                                                               TextWrapping="Wrap" />
                                                    <components:HoverMarqueeTextBlock Grid.Column="1"
                                                            Text="{Binding Content}"
                                                            Classes="compactFeedContent" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <TabItem Header="历史">
                        <Grid RowDefinitions="Auto,*"
                              RowSpacing="10"
                              Margin="0,10,0,0">
                            <Grid ColumnDefinitions="*,Auto,Auto"
                                  ColumnSpacing="8">
                                <TextBlock Text="同传历史"
                                           Classes="sectionTitle"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        ToolTip.Tip="导出 Excel"
                                        Classes="iconButton"
                                        IsEnabled="{Binding HasTranslateHistory}"
                                        Click="ExportTranslateHistory_OnClick">
                                    <LucideIcon Kind="Download" />
                                </Button>
                                <Button Grid.Column="2"
                                        ToolTip.Tip="清空历史"
                                        Classes="iconButton"
                                        IsEnabled="{Binding HasTranslateHistory}"
                                        Command="{Binding ClearTranslateHistoryCommand}">
                                    <LucideIcon Kind="Trash2" />
                                </Button>
                            </Grid>
                            <ScrollViewer Grid.Row="1">
                                <ItemsControl Classes="scrollSafeContent"
                                              ItemsSource="{Binding TranslateHistoryItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="workspace:DanmuFeedItem">
                                            <Border Classes="historyRecordCard">
                                                <Grid RowDefinitions="Auto,Auto"
                                                      RowSpacing="4">
                                                    <Grid ColumnDefinitions="*,Auto"
                                                          ColumnSpacing="8">
                                                        <TextBlock Text="{Binding DisplayTime}"
                                                                   Classes="danmuFeedMeta" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Status}"
                                                                   Classes="danmuFeedMeta"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                    <TextBlock Grid.Row="1"
                                                               Text="{Binding Content}"
                                                               Classes="danmuFeedContent"
                                                               TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <TabItem Header="歌词">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*"
                              RowSpacing="8"
                              Margin="0,10,0,0">
                            <Grid ColumnDefinitions="*,Auto,Auto"
                                  ColumnSpacing="8">
                                <Button x:Name="LyricTitleButton"
                                        Classes="lyricTitleButton"
                                        IsEnabled="{Binding HasLyricTitle}"
                                        ToolTip.Tip="点击复制歌词标题"
                                        VerticalAlignment="Center"
                                        Click="LyricTitle_OnClick">
                                    <TextBlock Text="{Binding CurrentLyricTitleText}"
                                               TextTrimming="CharacterEllipsis"
                                               FontWeight="SemiBold" />
                                </Button>
                                <Button Grid.Column="1"
                                        ToolTip.Tip="打开歌词库"
                                        Classes="iconButton"
                                        Command="{Binding #Root.OpenLyricLibraryPickerCommand}">
                                    <LucideIcon Kind="Library" />
                                </Button>
                                <Button Grid.Column="2"
                                        ToolTip.Tip="清空歌词"
                                        Classes="iconButton"
                                        Command="{Binding ClearLyricCommand}">
                                    <LucideIcon Kind="Trash2" />
                                </Button>
                            </Grid>

                            <Grid Grid.Row="1"
                                  ColumnDefinitions="Auto,*"
                                  ColumnSpacing="8">
                                <TextBlock Text="发送内容"
                                           Classes="muted"
                                           VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding LyricSendModeOptions}"
                                          SelectedValue="{Binding LyricSendMode}"
                                          SelectedValueBinding="{Binding Value}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="workspace:LyricSendModeOption">
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <Grid Grid.Row="2"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                                <Grid Grid.Column="0"
                                      ColumnDefinitions="Auto,Auto,56,Auto,Auto"
                                      ColumnSpacing="4"
                                      VerticalAlignment="Center">
                                    <TextBlock Text="速率"
                                               Classes="muted"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            ToolTip.Tip="倍率降低 0.1"
                                            Classes="iconButton"
                                            Command="{Binding DecreaseLyricPlaybackRateCommand}">
                                        <LucideIcon Kind="Minus" />
                                    </Button>
                                    <TextBox Grid.Column="2"
                                             Classes="lyricRateInput"
                                             Text="{Binding LyricPlaybackRate, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Column="3"
                                               Text="x"
                                               Classes="muted"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="4"
                                            ToolTip.Tip="倍率提高 0.1"
                                            Classes="iconButton"
                                            Command="{Binding IncreaseLyricPlaybackRateCommand}">
                                        <LucideIcon Kind="Plus" />
                                    </Button>
                                </Grid>

                                <CheckBox Grid.Column="1"
                                          Content="防重复"
                                          IsChecked="{Binding PreventRepeatedLyricSend}"
                                          ToolTip.Tip="退回已发送歌词时不重复发送"
                                          VerticalAlignment="Center" />
                            </Grid>

                            <Grid Grid.Row="3"
                                  ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto"
                                  ColumnSpacing="8">
                                <Button Grid.Column="0"
                                        ToolTip.Tip="快退 0.5 秒"
                                        Classes="iconButton"
                                        Command="{Binding RewindLyricCommand}">
                                    <LucideIcon Kind="CircleArrowLeft" />
                                </Button>
                                <Button Grid.Column="1"
                                        ToolTip.Tip="快进 0.5 秒"
                                        Classes="iconButton"
                                        Command="{Binding FastForwardLyricCommand}">
                                    <LucideIcon Kind="CircleArrowRight" />
                                </Button>
                                <Button x:Name="NextLyricButton"
                                        Grid.Column="2"
                                        ToolTip.Tip="跳到下一句并发送"
                                        AutomationProperties.Name="下一句歌词"
                                        Classes="iconButton"
                                        Click="NextLyricButton_OnClick"
                                        Command="{Binding SeekNextLyricCommand}">
                                    <LucideIcon Kind="SkipForward" />
                                </Button>
                                <Button Grid.Column="4"
                                        ToolTip.Tip="{Binding LyricAutoSendingToggleToolTip}"
                                        Classes="iconButton"
                                        Classes.selected="{Binding IsLyricAutoSending}"
                                        Command="{Binding ToggleAutoLyricCommand}">
                                    <Grid>
                                        <LucideIcon Kind="CirclePlay"
                                                    IsVisible="{Binding IsLyricAutoSendingPaused}" />
                                        <LucideIcon Kind="CirclePause"
                                                    IsVisible="{Binding IsLyricAutoSending}" />
                                    </Grid>
                                </Button>
                                <Button Grid.Column="5"
                                        ToolTip.Tip="停止歌词发送"
                                        Classes="iconButton"
                                        Command="{Binding StopAutoLyricCommand}">
                                    <LucideIcon Kind="CircleStop" />
                                </Button>
                            </Grid>
                            <ListBox x:Name="LyricListBox"
                                      Grid.Row="4"
                                      Classes="lyricLineList"
                                      ToolTip.Tip="选中歌词后，使用复制快捷键按当前发送内容设置复制"
                                     ItemsSource="{Binding Lyrics}"
                                     SelectedItem="{Binding ActiveLyricLine, Mode=OneWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="workspace:LyricLineState">
                                        <Border Classes="lyricLine"
                                                Classes.active="{Binding IsActive}"
                                                Classes.sent="{Binding IsSent}"
                                                DoubleTapped="LyricLine_OnDoubleTapped">
                                            <Grid>
                                                <ProgressBar Classes="lyricLineProgress"
                                                             Minimum="0"
                                                             Maximum="1"
                                                             Value="{Binding Progress}"
                                                             IsHitTestVisible="False" />
                                                <Grid ColumnDefinitions="56,*"
                                                      Margin="0,1">
                                                    <TextBlock Text="{Binding Timeline}"
                                                               Classes="muted"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                Spacing="2">
                                                        <TextBlock Text="{Binding Content}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding TranslatedContent}"
                                                                   Classes="muted"
                                                                   IsVisible="{Binding HasTranslatedContent}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <TabItem Header="转发">
                        <Grid RowDefinitions="Auto,*"
                              RowSpacing="10"
                              Margin="0,10,0,0">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                                <StackPanel>
                                    <TextBlock Text="监听其它直播间并转发匹配弹幕"
                                               Classes="sectionTitle" />
                                    <TextBlock Text="UID 和正则至少填写一个；都填写时需同时满足。命中后会自动套用开闭规则。"
                                               Classes="muted" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Classes="iconButton"
                                        ToolTip.Tip="添加转发规则"
                                        Command="{Binding AddForwardRuleCommand}">
                                    <LucideIcon Kind="Plus" />
                                </Button>
                            </Grid>
                            <ScrollViewer Grid.Row="1">
                                <ItemsControl Classes="scrollSafeContent"
                                              ItemsSource="{Binding ForwardRules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="forwardRuleCard">
                                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                                      RowSpacing="8">
                                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                                          ColumnSpacing="8">
                                                        <CheckBox IsChecked="{Binding IsEnabled}"
                                                                  VerticalAlignment="Center" />
                                                        <ComboBox Grid.Column="1"
                                                                  HorizontalAlignment="Stretch"
                                                                  ItemsSource="{Binding DataContext.ForwardSourceRooms, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  SelectedValue="{Binding SourceRoomKey}"
                                                                  SelectedValueBinding="{Binding Key}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate
                                                                    DataType="workspace:ForwardSourceRoomOption">
                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                        <Button Grid.Column="2"
                                                                Classes="iconButton"
                                                                ToolTip.Tip="删除规则"
                                                                Command="{Binding DataContext.RemoveForwardRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <LucideIcon Kind="Trash2" />
                                                        </Button>
                                                    </Grid>
                                                    <Grid Grid.Row="1"
                                                          ColumnDefinitions="*">
                                                        <TextBox Watermark="发送人 UID"
                                                                 Text="{Binding SenderUid}" />
                                                    </Grid>
                                                    <Grid Grid.Row="2"
                                                          ColumnDefinitions="*">
                                                        <TextBox
                                                            Watermark="同传格式正则，例如 ^【.*】$"
                                                            Text="{Binding ContentPattern}" />
                                                    </Grid>
                                                    <Grid Grid.Row="3"
                                                          ColumnDefinitions="*">
                                                        <ComboBox
                                                            HorizontalAlignment="Stretch"
                                                            ToolTip.Tip="转发发送账号"
                                                            ItemsSource="{Binding DataContext.ForwardAccountOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            SelectedValue="{Binding AccountOverrideId}"
                                                            SelectedValueBinding="{Binding AccountId}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate DataType="items:ForwardAccountOption">
                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>
                                                    <Grid Grid.Row="4"
                                                          ColumnDefinitions="*">
                                                        <ComboBox
                                                            HorizontalAlignment="Stretch"
                                                            ToolTip.Tip="转发开闭规则"
                                                            ItemsSource="{Binding DataContext.SymbolGroups, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            SelectedValue="{Binding MarkSymbolGroupId}"
                                                            SelectedValueBinding="{Binding Id}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate DataType="state:MarkSymbolGroup">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>
                                                    <TextBlock Grid.Row="5"
                                                               Text="{Binding StatusText}"
                                                               Classes="muted" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <Border Classes="lyricPickerOverlay"
                    IsVisible="{Binding DataContext.IsLyricLibraryPickerOpen, RelativeSource={RelativeSource AncestorType=Window}}"
                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                <Border Classes="lyricPickerPanel">
                    <Grid RowDefinitions="Auto,*"
                          RowSpacing="12">
                        <Grid ColumnDefinitions="*,Auto,Auto"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="8">
                            <TextBlock Text="歌词库"
                                       Classes="sectionTitle"
                                       VerticalAlignment="Center" />
                            <components:LyricLocalImportButton Grid.Column="1"
                                                               IsCompact="True"
                                                               LoadToCurrentRoom="True"
                                                               VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    Classes="iconButton"
                                    ToolTip.Tip="关闭"
                                    AutomationProperties.Name="关闭歌词库"
                                    Command="{Binding #Root.CloseLyricLibraryPickerCommand}">
                                <LucideIcon Kind="X" />
                            </Button>
                            <TextBlock Grid.Row="1"
                                       Grid.ColumnSpan="3"
                                       Text="选择后加载到当前直播间"
                                       Classes="muted"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </Grid>
                        <TabControl Grid.Row="1"
                                    Classes="lyricPickerTabs"
                                    SelectedIndex="0">
                            <TabItem Header="本地歌词">
                                <components:LyricLibraryListView Margin="0,10,0,0"
                                                                 EnableResultScrolling="True" />
                            </TabItem>
                            <TabItem Header="在线搜索">
                                <components:LyricOnlineImportView Margin="0,10,0,0"
                                                                  ShowHeader="False"
                                                                  ShowLocalImportButton="False"
                                                                  LoadToCurrentRoom="True"
                                                                  EnableResultScrolling="True" />
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>
