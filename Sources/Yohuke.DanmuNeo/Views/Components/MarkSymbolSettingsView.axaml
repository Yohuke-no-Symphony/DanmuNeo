<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:state="clr-namespace:Yohuke.DanmuNeo.Models.State"
             x:Class="Yohuke.DanmuNeo.Views.Components.MarkSymbolSettingsView"
             x:CompileBindings="False"
             x:Name="Root">
    <StackPanel Spacing="18"
                IsVisible="{Binding IsMarkSettingsSelected}">
        <Border Classes="panel" Padding="14">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <StackPanel>
                        <TextBlock Text="{Loc Key=UI.MarkSymbolSettingsView.Title}"
                                   Classes="sectionTitle"/>
                        <TextBlock Text="{Loc Key=UI.MarkSymbolSettingsView.GroupsHint}"
                                   Classes="muted"/>
                    </StackPanel>
	                    <Button Grid.Column="1"
	                            Command="{Binding #Root.AddSymbolGroupCommand}">
	                        <StackPanel Orientation="Horizontal"
	                                    Spacing="6">
	                            <LucideIcon Kind="FolderPlus"/>
	                            <TextBlock Text="{Loc Key=UI.MarkSymbolSettingsView.AddGroup}"/>
	                        </StackPanel>
	                    </Button>
                </Grid>

                <ItemsControl ItemsSource="{Binding SymbolGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="state:MarkSymbolGroup">
                            <Border Classes="markGroupCard">
                                <Grid RowDefinitions="Auto,Auto"
                                      RowSpacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto"
                                          ColumnSpacing="8">
	                                        <Button Classes="iconButton"
	                                                Command="{Binding #Root.ToggleSymbolGroupExpandedCommand}"
	                                                CommandParameter="{Binding}">
	                                            <LucideIcon Kind="PanelBottomOpen"/>
	                                        </Button>
                                        <StackPanel Grid.Column="1"
                                                    Spacing="2">
                                            <TextBox Text="{Binding Name}"
                                                     Watermark="{Loc Key=UI.MarkSymbolSettingsView.GroupName}"/>
                                        </StackPanel>
	                                        <Button Grid.Column="2"
	                                                Classes="iconButton"
	                                                ToolTip.Tip="{Loc Key=UI.MarkSymbolSettingsView.MoveUp}"
	                                                Command="{Binding #Root.MoveSymbolGroupUpCommand}"
	                                                CommandParameter="{Binding}">
	                                            <LucideIcon Kind="SquareArrowUp"/>
	                                        </Button>
	                                        <Button Grid.Column="3"
	                                                Classes="iconButton"
	                                                ToolTip.Tip="{Loc Key=UI.MarkSymbolSettingsView.MoveDown}"
	                                                Command="{Binding #Root.MoveSymbolGroupDownCommand}"
	                                                CommandParameter="{Binding}">
	                                            <LucideIcon Kind="SquareArrowDown"/>
	                                        </Button>
	                                        <Button Grid.Column="4"
	                                                Classes="iconButton"
	                                                ToolTip.Tip="{Loc Key=UI.MarkSymbolSettingsView.Delete}"
	                                                Command="{Binding #Root.DeleteSymbolGroupCommand}"
	                                                CommandParameter="{Binding}">
	                                            <LucideIcon Kind="Trash2"/>
	                                        </Button>
                                    </Grid>

                                    <Grid Grid.Row="1"
                                          ColumnDefinitions="*,*,*,*"
                                          ColumnSpacing="8"
                                          IsVisible="{Binding IsExpanded}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Loc Key=UI.MarkSymbolSettingsView.TranslationPrefixHint}"
                                                       Classes="muted"/>
                                            <TextBox Watermark="{Loc Key=UI.MarkSymbolSettingsView.TranslationPrefix}"
                                                     Text="{Binding TranslateOpenMark}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Spacing="4">
                                            <TextBlock Text="{Loc Key=UI.MarkSymbolSettingsView.TranslationSuffixHint}"
                                                       Classes="muted"/>
                                            <TextBox Watermark="{Loc Key=UI.MarkSymbolSettingsView.TranslationSuffix}"
                                                     Text="{Binding TranslateCloseMark}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2"
                                                    Spacing="4">
                                            <TextBlock Text="{Loc Key=UI.MarkSymbolSettingsView.LyricPrefixHint}"
                                                       Classes="muted"/>
                                            <TextBox Watermark="{Loc Key=UI.MarkSymbolSettingsView.LyricPrefix}"
                                                     Text="{Binding LyricOpenMark}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3"
                                                    Spacing="4">
                                            <TextBlock Text="{Loc Key=UI.MarkSymbolSettingsView.LyricSuffixHint}"
                                                       Classes="muted"/>
                                            <TextBox Watermark="{Loc Key=UI.MarkSymbolSettingsView.LyricSuffix}"
                                                     Text="{Binding LyricCloseMark}"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
