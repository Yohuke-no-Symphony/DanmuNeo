<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Yohuke.DanmuNeo.ViewModels"
             xmlns:items="clr-namespace:Yohuke.DanmuNeo.ViewModels.Items"
             x:Class="Yohuke.DanmuNeo.Views.Components.TitleBarView"
             x:Name="Root"
             Height="42"
             x:DataType="viewModels:MainWindowViewModel"
             x:CompileBindings="True">
    <Border Padding="{Binding #Root.CaptionInsets}"
            Background="{DynamicResource AppTitleBarBrush}">
        <Grid Classes="titleBar"
              PointerPressed="TitleBar_OnPointerPressed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock Text="夜半同传"
                           FontWeight="SemiBold"
                           FontSize="13" />
                <TextBlock Text="{Binding SelectedWorkspace.Name, FallbackValue=默认工作区}"
                           MaxWidth="180"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding SelectedWorkspace.Name}"
                           Classes="muted" />
            </StackPanel>
            <ContentPresenter Grid.Column="1"
                              Content="{Binding #Root.MenuContent}"
                              IsVisible="{Binding #Root.MenuContent.IsVisible, FallbackValue=False}"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center" />
            <Grid x:Name="RoomHeaderRegion" Grid.Column="2" Margin="8,0"
                  IsVisible="{Binding !!SelectedWorkspace.SelectedRoom}">
                <Grid x:Name="RoomHeader"
                      DataContext="{Binding SelectedWorkspace.SelectedRoom, DataType=viewModels:MainWindowViewModel}"
                      x:DataType="items:LiveRoomTabViewModel"
                      ColumnDefinitions="Auto,*,Auto,Auto"
                      ColumnSpacing="10"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Border Classes="listenStatusLight"
                            Classes.listening="{Binding IsListening}"
                            Classes.idle="{Binding IsNotListening}"
                            ToolTip.Tip="{Binding ConnectionStatus}" />
                    <TextBlock x:Name="CurrentRoomName" Grid.Column="1"
                               Text="{Binding RoomName}"
                               MaxWidth="240"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding RoomName}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="CurrentRoomId" Grid.Column="2"
                               Text="{Binding RoomId}"
                               Classes="muted"
                               VerticalAlignment="Center" />
                    <Button x:Name="ListenToggleButton" Grid.Column="3"
                            Classes="listenToggleButton"
                            Classes.listening="{Binding IsListening}"
                            Classes.idle="{Binding IsNotListening}"
                            MinHeight="32"
                            Height="32"
                            Padding="10,4"
                            Command="{Binding ToggleListeningCommand}"
                            ToolTip.Tip="{Binding ConnectionStatus}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <LucideIcon Kind="Radio" IsVisible="{Binding IsNotListening}" />
                            <LucideIcon Kind="CircleStop" IsVisible="{Binding IsListening}" />
                            <TextBlock Text="{Binding ListenToggleText}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
            <StackPanel x:Name="WindowButtons" Grid.Column="3"
                        Orientation="Horizontal"
                        Margin="0,0,8,0"
                        Spacing="4"
                        VerticalAlignment="Center">
                <Button x:Name="DebugToolsButton"
                        Classes="iconButton"
                        ToolTip.Tip="弹幕与 SC 样式测试"
                        IsVisible="False"
                        Click="DebugTools_OnClick">
                    <LucideIcon Kind="Bug" />
                </Button>
                <Button x:Name="PinButton"
                        Classes="iconButton"
                        ToolTip.Tip="窗口置顶"
                        Click="Pin_OnClick">
                    <Grid>
                        <LucideIcon x:Name="PinOutlineIcon"
                                    Kind="Pin" />
                        <PathIcon x:Name="PinSolidIcon"
                                  Data="M16,12 L18,14 L18,16 L12.8,16 L12.8,22 L11.2,22 L11.2,16 L6,16 L6,14 L8,12 L8,4 L7,4 L7,2 L17,2 L17,4 L16,4 Z"
                                  IsVisible="False" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
