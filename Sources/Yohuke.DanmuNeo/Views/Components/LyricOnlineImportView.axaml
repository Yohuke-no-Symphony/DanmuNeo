<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:state="clr-namespace:Yohuke.DanmuNeo.Models.State"
             xmlns:components="clr-namespace:Yohuke.DanmuNeo.Views.Components"
             x:Class="Yohuke.DanmuNeo.Views.Components.LyricOnlineImportView"
             x:CompileBindings="False"
             x:Name="Root">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Yohuke.DanmuNeo/Views/Styles/MusicProviderIcons.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Button.musicProviderButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button.musicProviderButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppSidebarHoverBrush}"/>
        </Style>
        <Style Selector="Button.musicProviderButton.selected">
            <Setter Property="Background" Value="{DynamicResource AppSidebarSelectedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.lyricSearchButton">
            <Setter Property="Width" Value="74"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style Selector="ScrollViewer.musicLyricResults">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style Selector="ScrollViewer.musicLyricResults.scrollable">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="AllowAutoHide" Value="False"/>
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*"
          RowSpacing="12">
        <StackPanel Spacing="12">
            <StackPanel Spacing="4"
                        IsVisible="{Binding #Root.ShowHeader}">
                <TextBlock Text="{Loc Key=UI.LyricOnlineImportView.Title}"
                           Classes="sectionTitle"/>
                <TextBlock Text="{Loc Key=UI.LyricOnlineImportView.ImportHint}"
                           Classes="muted"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <components:LyricLocalImportButton HorizontalAlignment="Left"
                                               IsVisible="{Binding #Root.ShowLocalImportButton}"
                                               LoadToCurrentRoom="{Binding #Root.LoadToCurrentRoom}"/>

            <StackPanel Orientation="Horizontal"
                        Spacing="8">
                <Button Classes="musicProviderButton"
                        Classes.selected="{Binding IsNetEaseMusicLyricSource}"
                        ToolTip.Tip="{Loc Key=UI.LyricOnlineImportView.NetEaseMusic}"
                        AutomationProperties.Name="{Loc Key=UI.LyricOnlineImportView.NetEaseMusic}"
                        Command="{Binding #Root.SelectNetEaseMusicLyricSourceCommand}">
                    <Image Width="24"
                           Height="24"
                           Source="{StaticResource NetEaseMusicIcon}"/>
                </Button>
                <Button Classes="musicProviderButton"
                        Classes.selected="{Binding IsQQMusicLyricSource}"
                        ToolTip.Tip="{Loc Key=UI.LyricOnlineImportView.QqMusic}"
                        AutomationProperties.Name="{Loc Key=UI.LyricOnlineImportView.QqMusic}"
                        Command="{Binding #Root.SelectQQMusicLyricSourceCommand}">
                    <Image Width="24"
                           Height="24"
                           Source="{StaticResource QQMusicIcon}"/>
                </Button>
            </StackPanel>
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <TextBox x:Name="MusicLyricSearchTextBox"
                         MinWidth="0"
                         MinHeight="36"
                         Watermark="{Loc Key=UI.LyricOnlineImportView.SearchWatermark}"
                         AutomationProperties.Name="{Loc Key=UI.LyricOnlineImportView.SearchKeywords}"
                         Text="{Binding MusicLyricSearchText}"
                         KeyDown="MusicLyricSearch_OnKeyDown"/>
                <Button Grid.Column="1"
                        Classes="primaryButton lyricSearchButton"
                        AutomationProperties.Name="{Loc Key=UI.LyricOnlineImportView.SearchOnlineLyrics}"
                        IsEnabled="{Binding !IsMusicLyricSearching}"
                        Command="{Binding #Root.SearchMusicLyricsCommand}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="6">
                        <LucideIcon Kind="Search"/>
                        <TextBlock Text="{Loc Key=UI.LyricOnlineImportView.Search}"/>
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock Text="{Loc Key=UI.LyricOnlineImportView.Searching}"
                       Classes="muted"
                       IsVisible="{Binding IsMusicLyricSearching}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1"
                      Classes="musicLyricResults"
                      Classes.scrollable="{Binding #Root.EnableResultScrolling}">
            <ItemsControl ItemsSource="{Binding MusicLyricSearchResults}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="state:MusicLyricSearchResult">
                        <Border BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="0,8">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               FontWeight="SemiBold"
                                               ToolTip.Tip="{Binding DisplayTitle}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Album}"
                                               Classes="muted"
                                               ToolTip.Tip="{Binding Album}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SourceLabel}"
                                               Classes="muted"
                                               ToolTip.Tip="{Binding SourceLabel}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Classes="iconButton"
                                        ToolTip.Tip="{Loc Key=UI.LyricOnlineImportView.ImportLyrics}"
                                        AutomationProperties.Name="{Loc Key=UI.LyricOnlineImportView.ImportOnlineLyrics}"
                                        VerticalAlignment="Center"
                                        Command="{Binding #Root.ImportMusicLyricCommand}"
                                        CommandParameter="{Binding}">
                                    <LucideIcon Kind="Download"/>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
