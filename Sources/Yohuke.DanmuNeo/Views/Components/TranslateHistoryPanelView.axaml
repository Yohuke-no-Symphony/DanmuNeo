<components:WorkbenchRoomPanel xmlns="https://github.com/avaloniaui"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:workspace="clr-namespace:Yohuke.DanmuNeo.Models.Workspace"
                               xmlns:state="clr-namespace:Yohuke.DanmuNeo.Models.State"
                               xmlns:components="clr-namespace:Yohuke.DanmuNeo.Views.Components"
                               xmlns:items="clr-namespace:Yohuke.DanmuNeo.ViewModels.Items"
                               x:Class="Yohuke.DanmuNeo.Views.Components.TranslateHistoryPanelView"
                               x:DataType="items:LiveRoomTabViewModel"
                               x:CompileBindings="True"
                               x:Name="Root">
    <Grid RowDefinitions="Auto,*"
          RowSpacing="10"
          Margin="0">
        <Grid ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="8">
            <TextBlock Text="同传历史"
                       Classes="sectionTitle"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    ToolTip.Tip="导出 Excel"
                    Classes="iconButton"
                    IsEnabled="{Binding HasTranslateHistory}"
                    Click="ExportTranslateHistory_OnClick">
                <LucideIcon Kind="Download" />
            </Button>
            <Button Grid.Column="2"
                    ToolTip.Tip="清空历史"
                    Classes="iconButton"
                    IsEnabled="{Binding HasTranslateHistory}"
                    Command="{Binding ClearTranslateHistoryCommand}">
                <LucideIcon Kind="Trash2" />
            </Button>
        </Grid>
        <ScrollViewer Grid.Row="1">
            <ItemsControl Classes="scrollSafeContent"
                          ItemsSource="{Binding TranslateHistoryItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="workspace:DanmuFeedItem">
                        <Border Classes="historyRecordCard">
                            <Grid RowDefinitions="Auto,Auto"
                                  RowSpacing="4">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">
                                    <TextBlock Text="{Binding DisplayTime}"
                                               Classes="danmuFeedMeta" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Status}"
                                               Classes="danmuFeedMeta"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Content}"
                                           Classes="danmuFeedContent"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</components:WorkbenchRoomPanel>
