<components:WorkbenchRoomPanel xmlns="https://github.com/avaloniaui"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:workspace="clr-namespace:Yohuke.DanmuNeo.Models.Workspace"
                               xmlns:state="clr-namespace:Yohuke.DanmuNeo.Models.State"
                               xmlns:components="clr-namespace:Yohuke.DanmuNeo.Views.Components"
                               xmlns:items="clr-namespace:Yohuke.DanmuNeo.ViewModels.Items"
                               x:Class="Yohuke.DanmuNeo.Views.Components.LivePlayerPanelView"
                               x:DataType="items:LiveRoomTabViewModel"
                               x:CompileBindings="True"
                               x:Name="Root">
    <Grid
        RowDefinitions="Auto,*"
        RowSpacing="8">
        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8"
                   Margin="8,4,8,0"
                   VerticalAlignment="Center">
            <ComboBox Height="{StaticResource WorkbenchControlHeight}" Width="160"
                      PlaceholderText="{Loc Key=UI.LivePlayerPanelView.Quality}"
                      VerticalAlignment="Center"
                      VerticalContentAlignment="Center"
                      ItemsSource="{Binding LiveQualityOptions}"
                      SelectedItem="{Binding SelectedLiveQuality}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="workspace:LiveQualityOption">
                        <TextBlock Text="{Binding Description}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button ToolTip.Tip="{Binding LivePlayerToggleToolTip}"
                        Classes="iconButton"
                        Classes.selected="{Binding IsLivePlayerVisible}"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleLivePlayerCommand}">
                    <Grid>
                        <LucideIcon Kind="CirclePlay"
                                    IsVisible="{Binding IsLivePlayerHidden}" />
                        <LucideIcon Kind="CircleStop"
                                    IsVisible="{Binding IsLivePlayerVisible}" />
                    </Grid>
                </Button>
                <Button ToolTip.Tip="{Loc Key=UI.LivePlayerPanelView.ChaseLive}"
                        Classes="iconButton"
                        VerticalAlignment="Center"
                        Command="{Binding ChaseLiveCommand}">
                    <LucideIcon Kind="RefreshCw" />
                </Button>
                <Button x:Name="FrameCaptureButton" ToolTip.Tip="{Loc Key=Captures.Capture}"
                        Classes="iconButton"
                        VerticalAlignment="Center"
                        IsEnabled="{Binding IsLivePlayerVisible}"
                        Click="Capture_OnClick">
                    <LucideIcon Kind="Camera" />
                </Button>
                <Button ToolTip.Tip="{Loc Key=UI.LivePlayerPanelView.Mute}"
                        Classes="iconButton"
                        Classes.selected="{Binding IsLivePlayerMuted}"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleLivePlayerMutedCommand}">
                    <Grid>
                        <LucideIcon Kind="Volume2"
                                    IsVisible="{Binding IsLivePlayerAudible}" />
                        <LucideIcon Kind="VolumeX"
                                    IsVisible="{Binding IsLivePlayerMuted}" />
                    </Grid>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Slider Width="100" Height="24" MinHeight="24" Padding="0" Minimum="0"
                        Maximum="100"
                        Value="{Binding LivePlayerVolumePercent}"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{Loc Key=UI.LivePlayerPanelView.Volume}">
                    <Slider.Resources>
                        <GridLength x:Key="SliderPreContentMargin">2</GridLength>
                        <GridLength x:Key="SliderPostContentMargin">2</GridLength>
                        <x:Double x:Key="SliderHorizontalHeight">24</x:Double>
                    </Slider.Resources>
                </Slider>
                <TextBlock Text="{Binding LivePlayerVolumeText}"
                           Classes="muted"
                           MinWidth="34" HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </StackPanel>
        </WrapPanel>

        <Grid Grid.Row="1">
            <Border x:Name="LivePlayerHost"
                    MinHeight="0"
                    Classes="livePlayerSurface" />
        </Grid>
    </Grid>
</components:WorkbenchRoomPanel>
