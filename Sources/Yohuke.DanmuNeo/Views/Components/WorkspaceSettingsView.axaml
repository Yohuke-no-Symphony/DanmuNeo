<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:items="clr-namespace:Yohuke.DanmuNeo.ViewModels.Items"
             xmlns:state="clr-namespace:Yohuke.DanmuNeo.Models.State"
             x:Class="Yohuke.DanmuNeo.Views.Components.WorkspaceSettingsView"
             x:CompileBindings="False"
             x:Name="Root">
    <StackPanel Spacing="18">
        <Border Classes="panel" Padding="14">
            <StackPanel Spacing="10">
                <TextBlock Text="{Loc Key=UI.WorkspaceSettingsView.Workspace}"
                           Classes="sectionTitle" />
                <Grid ColumnDefinitions="*,Auto,Auto"
                      ColumnSpacing="8">
                    <TextBox x:Name="WorkspaceNameInput"
                             Text="{Binding SelectedWorkspace.Name}"
                             Watermark="{Loc Key=UI.WorkspaceSettingsView.WorkspaceName}" />
                    <Button Grid.Column="1"
                            ToolTip.Tip="{Loc Key=UI.WorkspaceSettingsView.ExportShare}"
                            Classes="iconButton"
                            Click="ExportWorkspace_OnClick">
                        <LucideIcon Kind="FileDown" />
                    </Button>
                    <Button Grid.Column="2"
                            ToolTip.Tip="{Loc Key=UI.WorkspaceSettingsView.DeleteWorkspace}"
                            Classes="iconButton"
                            Command="{Binding #Root.OpenDeleteWorkspaceDialogCommand}"
                            CommandParameter="{Binding SelectedWorkspace}">
                        <LucideIcon Kind="Trash2" />
                    </Button>
                </Grid>
                <TextBlock Text="{Binding SelectedWorkspace.RoomCountText}"
                           Classes="muted" />
            </StackPanel>
        </Border>

        <Border Classes="panel" Padding="14">
            <StackPanel Spacing="10">
                <TextBlock Text="{Loc Key=UI.WorkspaceSettingsView.AccountOverride}"
                           Classes="sectionTitle" />
                <TextBlock Text="{Binding SelectedWorkspace.AccountLabel}"
                           Classes="muted" />
                <WrapPanel>
                    <Button Margin="0,0,8,8"
                            Command="{Binding #Root.ClearWorkspaceAccountCommand}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <LucideIcon Kind="Globe" />
                            <TextBlock Text="{Loc Key=UI.WorkspaceSettingsView.UseGlobalAccount}" />
                        </StackPanel>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Accounts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="state:BilibiliAccount">
                                <Button Content="{Binding Name}"
                                        Margin="0,0,8,8"
                                        Command="{Binding #Root.SetWorkspaceAccountCommand}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Classes="panel" Padding="14">
            <StackPanel Spacing="10">
                <TextBlock Text="{Loc Key=UI.WorkspaceSettingsView.SymbolGroup}"
                           Classes="sectionTitle" />
                <TextBlock Text="{Loc Key=UI.WorkspaceSettingsView.SymbolGroupHint}"
                           Classes="muted" />
                <ComboBox ItemsSource="{Binding SymbolGroups}"
                          SelectedItem="{Binding SelectedWorkspaceMarkGroup}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="state:MarkSymbolGroup">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Border>

        <Border Classes="panel" Padding="14">
            <StackPanel Spacing="10">
                <TextBlock Text="{Loc Key=UI.WorkspaceSettingsView.Rooms}"
                           Classes="sectionTitle" />
                <ItemsControl ItemsSource="{Binding SelectedWorkspace.Rooms}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="items:LiveRoomTabViewModel">
                            <Grid ColumnDefinitions="*,140,140,Auto"
                                  ColumnSpacing="8"
                                  Margin="0,4">
                                <TextBox Text="{Binding RoomName, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="{Loc Key=UI.WorkspaceSettingsView.RoomName}"
                                         LostFocus="RoomInfo_OnLostFocus" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding RoomId, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="{Loc Key=UI.WorkspaceSettingsView.RoomId}"
                                         LostFocus="RoomInfo_OnLostFocus" />
                                <TextBox Grid.Column="2"
                                         Text="{Binding OwnerUid, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="{Loc Key=UI.WorkspaceSettingsView.StreamerUid}"
                                         LostFocus="RoomInfo_OnLostFocus" />
                                <Button Grid.Column="3"
                                        ToolTip.Tip="{Loc Key=UI.WorkspaceSettingsView.DeleteRoom}"
                                        Classes="iconButton"
                                        Command="{Binding #Root.OpenDeleteRoomDialogCommand}"
                                        CommandParameter="{Binding}">
                                    <LucideIcon Kind="Trash2" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
