<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:state="clr-namespace:Yohuke.DanmuNeo.Models.State"
             xmlns:components="clr-namespace:Yohuke.DanmuNeo.Views.Components"
             x:Class="Yohuke.DanmuNeo.Views.Components.LyricLibrarySettingsView"
             x:CompileBindings="False"
             x:Name="Root">
    <StackPanel Spacing="18"
                IsVisible="{Binding IsLyricLibrarySettingsSelected}">
        <Border Classes="panel"
                Padding="14">
            <components:LyricOnlineImportView/>
        </Border>

        <Border Classes="panel"
                Padding="14">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <StackPanel>
                        <TextBlock Text="{Loc Key=UI.LyricLibrarySettingsView.Title}"
                                   Classes="sectionTitle"/>
                        <TextBlock Text="{Loc Key=UI.LyricLibrarySettingsView.LibraryHint}"
                                   Classes="muted"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding #Root.SaveCurrentLyricToLibraryCommand}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <LucideIcon Kind="Save"/>
                            <TextBlock Text="{Loc Key=UI.LyricLibrarySettingsView.SaveCurrent}"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <components:LyricLibraryListView/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
