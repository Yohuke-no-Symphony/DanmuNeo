<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:Yohuke.DanmuNeo.Views.Components"
             xmlns:vm="clr-namespace:Yohuke.DanmuNeo.ViewModels"
             x:Class="Yohuke.DanmuNeo.Views.Components.LyricLibraryPickerView"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="True"
             x:Name="Root">
    <Border x:Name="DialogSurface"
            Background="{DynamicResource AppCardBrush}"
            Padding="{StaticResource WorkbenchPanelPadding}">
        <Grid RowDefinitions="Auto,*"
              RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="8">
                <TextBlock Text="{Loc Key=UI.LyricLibraryPickerView.Title}"
                           Classes="sectionTitle"
                           VerticalAlignment="Center" />
                <components:LyricLocalImportButton Grid.Column="1"
                                                   IsCompact="True"
                                                   LoadToCurrentRoom="True"
                                                   VerticalAlignment="Center" />
                <TextBlock Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Text="{Loc Key=UI.LyricLibraryPickerView.LoadHint}"
                           Classes="muted"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </Grid>
            <TabControl Grid.Row="1"
                        Classes="lyricPickerTabs"
                        SelectedIndex="0">
                <TabItem Header="{Loc Key=UI.LyricLibraryPickerView.LocalLyrics}">
                    <components:LyricLibraryListView Margin="0,10,0,0"
                                                     EnableResultScrolling="True" />
                </TabItem>
                <TabItem Header="{Loc Key=UI.LyricLibraryPickerView.OnlineSearch}">
                    <components:LyricOnlineImportView Margin="0,10,0,0"
                                                      ShowHeader="False"
                                                      ShowLocalImportButton="False"
                                                      LoadToCurrentRoom="True"
                                                      EnableResultScrolling="True" />
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
