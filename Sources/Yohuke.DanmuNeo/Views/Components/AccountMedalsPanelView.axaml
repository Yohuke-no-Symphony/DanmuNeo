<components:WorkbenchPanelView xmlns="https://github.com/avaloniaui"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:components="clr-namespace:Yohuke.DanmuNeo.Views.Components"
                               xmlns:items="clr-namespace:Yohuke.DanmuNeo.ViewModels.Items"
                               xmlns:state="clr-namespace:Yohuke.DanmuNeo.Models.State"
                               xmlns:workspace="clr-namespace:Yohuke.DanmuNeo.Models.Workspace"
                               x:Class="Yohuke.DanmuNeo.Views.Components.AccountMedalsPanelView"
                               x:DataType="items:AccountMedalsViewModel"
                               x:CompileBindings="True">
    <components:WorkbenchPanelView.Styles>
        <Style Selector="Button.medalAction, ToggleButton.medalAction">
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style Selector="ListBox.medalList">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.medalList ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="CornerRadius" Value="{StaticResource WorkbenchControlCornerRadius}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.medalList ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppSidebarHoverBrush}" />
        </Style>
        <Style Selector="ListBox.medalList ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource AppSidebarSelectedBrush}" />
        </Style>
        <Style Selector="ListBox.medalList ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.medalList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSidebarHoverBrush}" />
        </Style>
        <Style Selector="ListBox.medalList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSidebarSelectedBrush}" />
        </Style>
        <Style Selector="Border.medalWearingBadge">
            <Setter Property="Background" Value="{DynamicResource AppSidebarSelectedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </components:WorkbenchPanelView.Styles>
    <Border Padding="{StaticResource WorkbenchPanelPadding}">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <ComboBox x:Name="MedalAccountChoice" MinWidth="0"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          IsEnabled="{Binding CanChooseAccount}"
                          PlaceholderText="{Loc Key=Medals.ChooseAccount}"
                          ItemsSource="{Binding Accounts}"
                          SelectedItem="{Binding SelectedAccount, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="state:BilibiliAccount">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ToggleButton x:Name="MedalFollowAccount" Grid.Column="1" Classes="iconButton"
                              IsChecked="{Binding FollowCurrentAccount, Mode=TwoWay}"
                              AutomationProperties.Name="{Loc Key=Workbench.FollowCurrentAccount}"
                              ToolTip.Tip="{Loc Key=Workbench.FollowCurrentAccount}">
                    <LucideIcon Kind="Link" />
                </ToggleButton>
                <Button x:Name="MedalRefresh" Grid.Column="2" Classes="iconButton"
                        Command="{Binding RefreshCommand}" ToolTip.Tip="{Loc Key=Medals.Refresh}">
                    <LucideIcon Kind="RefreshCw" />
                </Button>
            </Grid>
            <StackPanel Grid.Row="1" Spacing="6">
                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                    <ToggleButton x:Name="MedalAutomatic" Classes="actionToggle medalAction"
                                  IsEnabled="{Binding CanRefresh}"
                                  IsChecked="{Binding AutoSwitchMedal, Mode=TwoWay}"
                                  AutomationProperties.Name="{Loc Key=Medals.Automatic}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <LucideIcon Kind="Repeat" VerticalAlignment="Center" />
                            <TextBlock Text="{Loc Key=Medals.Automatic}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <Button x:Name="MedalWear" Classes="medalAction" Command="{Binding WearSelectedCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <LucideIcon Kind="BadgeCheck" VerticalAlignment="Center" />
                            <TextBlock Text="{Loc Key=Medals.Wear}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MedalTakeOff" Classes="medalAction" Command="{Binding TakeOffCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <LucideIcon Kind="BadgeMinus" VerticalAlignment="Center" />
                            <TextBlock Text="{Loc Key=Medals.TakeOff}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
            <ListBox Grid.Row="2" x:Name="MedalList" Classes="medalList" Grid.IsSharedSizeScope="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemsSource="{Binding Medals}"
                     SelectedItem="{Binding SelectedMedal, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="workspace:AccountMedal">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MedalLevel" />
                                <ColumnDefinition Width="1.8*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MedalState" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                            <TextBlock Grid.Column="1" Text="{Binding Level, StringFormat='Lv.{0}'}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Classes="muted" />
                            <TextBlock Grid.Column="2" Text="{Binding TargetName}" VerticalAlignment="Center"
                                       FontSize="{DynamicResource AppFontSizeCaption}" Classes="muted"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TargetName}" />
                            <Border Grid.Column="3" Classes="medalWearingBadge"
                                    IsVisible="{Binding IsWearing}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <LucideIcon Kind="Check" Size="12" VerticalAlignment="Center"
                                                Foreground="{DynamicResource AppTextBrush}" />
                                    <TextBlock Text="{Loc Key=Medals.Wearing}" FontSize="11" FontWeight="Medium"
                                               Foreground="{DynamicResource AppTextBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="3" Text="{Binding StatusText}" Classes="muted" TextWrapping="Wrap"/>
        </Grid>
    </Border>
</components:WorkbenchPanelView>
