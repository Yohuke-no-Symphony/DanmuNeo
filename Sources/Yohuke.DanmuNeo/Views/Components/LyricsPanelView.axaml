<components:WorkbenchRoomPanel xmlns="https://github.com/avaloniaui"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:workspace="clr-namespace:Yohuke.DanmuNeo.Models.Workspace"
                               xmlns:components="clr-namespace:Yohuke.DanmuNeo.Views.Components"
                               xmlns:items="clr-namespace:Yohuke.DanmuNeo.ViewModels.Items"
                               x:Class="Yohuke.DanmuNeo.Views.Components.LyricsPanelView"
                               x:DataType="items:LiveRoomTabViewModel"
                               x:CompileBindings="True"
                               x:Name="Root">
    <components:WorkbenchRoomPanel.Styles>
        <Style Selector="Button.lyricToolbarButton">
            <Setter Property="Height" Value="{StaticResource WorkbenchControlHeight}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style Selector="TextBox.lyricRateInput">
            <Setter Property="Height" Value="{StaticResource WorkbenchControlHeight}" />
            <Setter Property="MinHeight" Value="{StaticResource WorkbenchControlHeight}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </components:WorkbenchRoomPanel.Styles>
    <Border Padding="{StaticResource WorkbenchPanelPadding}">
        <Grid RowDefinitions="Auto,Auto,Auto,*"
              RowSpacing="8"
              Margin="0">
            <Grid ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="8">
                <Button x:Name="LyricTitleButton"
                        Classes="lyricTitleButton"
                        IsEnabled="{Binding HasLyricTitle}"
                        ToolTip.Tip="{Loc Key=UI.LyricsPanelView.CopyTitleHint}"
                        VerticalAlignment="Center"
                        Click="LyricTitle_OnClick">
                    <TextBlock Text="{Binding CurrentLyricTitleText}"
                               TextTrimming="CharacterEllipsis"
                               FontWeight="SemiBold" />
                </Button>
                <Button x:Name="LyricLibraryButton"
                        Grid.Column="1"
                        ToolTip.Tip="{Loc Key=UI.LyricsPanelView.OpenLibrary}"
                        AutomationProperties.Name="{Loc Key=UI.LyricsPanelView.OpenLibrary}"
                        Classes="lyricToolbarButton"
                        Command="{Binding #Root.OpenLyricLibraryPickerCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <LucideIcon Kind="Library" />
                        <TextBlock Text="{Loc Key=UI.LyricsPanelView.Library}" />
                    </StackPanel>
                </Button>
                <Button x:Name="LyricMoreButton"
                        Grid.Column="2"
                        ToolTip.Tip="{Loc Key=UI.LyricsPanelView.MoreActions}"
                        AutomationProperties.Name="{Loc Key=UI.LyricsPanelView.MoreActions}"
                        Classes="iconButton">
                    <LucideIcon Kind="Ellipsis" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="{Loc Key=UI.LyricsPanelView.ClearLyrics}"
                                      Command="{Binding ClearLyricCommand}">
                                <MenuItem.Icon>
                                    <LucideIcon Kind="Trash2" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <WrapPanel x:Name="LyricSendOptions"
                       Grid.Row="1"
                       ItemSpacing="16"
                       LineSpacing="8">
                <Grid ColumnDefinitions="Auto,Auto"
                      ColumnSpacing="8">
                    <TextBlock Text="{Loc Key=UI.LyricsPanelView.SendContent}"
                               Classes="muted"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="LyricSendModeSelector"
                              Grid.Column="1"
                              MinWidth="136"
                              MaxWidth="180"
                              HorizontalAlignment="Left"
                              AutomationProperties.Name="{Loc Key=UI.LyricsPanelView.LyricSendContent}"
                              ItemsSource="{Binding LyricSendModeOptions}"
                              SelectedValue="{Binding LyricSendMode}"
                              SelectedValueBinding="{Binding Value}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="workspace:LyricSendModeOption">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <CheckBox x:Name="PreventRepeatedLyricSendCheckBox"
                          Content="{Loc Key=UI.LyricsPanelView.PreventRepeatedSending}"
                          IsChecked="{Binding PreventRepeatedLyricSend}"
                          ToolTip.Tip="{Loc Key=UI.LyricsPanelView.PreventRepeatedSendingHint}"
                          VerticalAlignment="Center" />
            </WrapPanel>

            <WrapPanel x:Name="LyricPlaybackToolbar"
                       Grid.Row="2"
                       ItemSpacing="12"
                       LineSpacing="8">
                <Grid x:Name="LyricSendActions"
                      ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="4">
                    <Button x:Name="LyricAutoSendButton"
                            ToolTip.Tip="{Binding LyricAutoSendingToggleToolTip}"
                            AutomationProperties.Name="{Binding LyricAutoSendingToggleToolTip}"
                            Classes="lyricToolbarButton primaryButton"
                            Padding="8,4"
                            Command="{Binding ToggleAutoLyricCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Grid>
                                <LucideIcon Kind="Play"
                                            IsVisible="{Binding IsLyricAutoSendingPaused}" />
                                <LucideIcon Kind="Pause"
                                            IsVisible="{Binding IsLyricAutoSending}" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="{Loc Key=UI.LyricsPanelView.StartAutoSending}"
                                           IsVisible="{Binding IsLyricAutoSendingPaused}" />
                                <TextBlock Text="{Loc Key=UI.LyricsPanelView.PauseSending}"
                                           IsVisible="{Binding IsLyricAutoSending}" />
                            </Grid>
                        </StackPanel>
                    </Button>
                    <Button x:Name="LyricStopButton"
                            Grid.Column="1"
                            ToolTip.Tip="{Loc Key=UI.LyricsPanelView.StopAndReset}"
                            AutomationProperties.Name="{Loc Key=UI.LyricsPanelView.StopAndReset}"
                            Classes="iconButton"
                            Command="{Binding StopAutoLyricCommand}">
                        <LucideIcon Kind="Square" />
                    </Button>
                    <Button x:Name="NextLyricButton"
                            Grid.Column="2"
                            ToolTip.Tip="{Loc Key=UI.LyricsPanelView.SendNextHint}"
                            AutomationProperties.Name="{Loc Key=UI.LyricsPanelView.SendNext}"
                            Classes="iconButton"
                            Click="NextLyricButton_OnClick"
                            Command="{Binding SeekNextLyricCommand}">
                        <LucideIcon Kind="SkipForward" />
                    </Button>
                    <Button x:Name="NextLyricAndPlayButton"
                            Grid.Column="3"
                            ToolTip.Tip="{Loc Key=UI.LyricsPanelView.SendNextAndPlay}"
                            AutomationProperties.Name="{Loc Key=UI.LyricsPanelView.SendNextAndPlay}"
                            Classes="iconButton"
                            Click="NextLyricButton_OnClick"
                            Command="{Binding SeekNextAndPlayLyricCommand}">
                        <LucideIcon Kind="ListVideo" />
                    </Button>
                    <Button x:Name="LyricRewindButton"
                            Grid.Column="4"
                            ToolTip.Tip="{Loc Key=UI.LyricsPanelView.SeekBackward}"
                            AutomationProperties.Name="{Loc Key=UI.LyricsPanelView.SeekBackward}"
                            Classes="iconButton"
                            Command="{Binding RewindLyricCommand}">
                        <LucideIcon Kind="Rewind" />
                    </Button>
                    <Button x:Name="LyricFastForwardButton"
                            Grid.Column="5"
                            ToolTip.Tip="{Loc Key=UI.LyricsPanelView.SeekForward}"
                            AutomationProperties.Name="{Loc Key=UI.LyricsPanelView.SeekForward}"
                            Classes="iconButton"
                            Command="{Binding FastForwardLyricCommand}">
                        <LucideIcon Kind="FastForward" />
                    </Button>
                </Grid>
                <Grid x:Name="LyricPlaybackRateControls"
                      ColumnDefinitions="Auto,Auto"
                      ColumnSpacing="8">
                    <Border x:Name="LyricPlaybackRateSeparator"
                            Width="1"
                            Height="20"
                            Background="{DynamicResource AppBorderBrush}"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False" />
                    <Grid Grid.Column="1"
                          ColumnDefinitions="Auto,52,Auto,Auto"
                          ColumnSpacing="4">
                        <Button x:Name="LyricRateDecreaseButton"
                                ToolTip.Tip="{Loc Key=UI.LyricsPanelView.DecreaseRate}"
                                AutomationProperties.Name="{Loc Key=UI.LyricsPanelView.DecreaseRate}"
                                Classes="iconButton"
                                Command="{Binding DecreaseLyricPlaybackRateCommand}">
                            <LucideIcon Kind="Minus" />
                        </Button>
                        <TextBox x:Name="LyricPlaybackRateInput"
                                 Grid.Column="1"
                                 Classes="lyricRateInput"
                                 ToolTip.Tip="{Loc Key=UI.LyricsPanelView.PlaybackRate}"
                                 AutomationProperties.Name="{Loc Key=UI.LyricsPanelView.PlaybackRate}"
                                 Text="{Binding LyricPlaybackRate, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Column="2"
                                   Text="×"
                                   Classes="muted"
                                   VerticalAlignment="Center" />
                        <Button x:Name="LyricRateIncreaseButton"
                                Grid.Column="3"
                                ToolTip.Tip="{Loc Key=UI.LyricsPanelView.IncreaseRate}"
                                AutomationProperties.Name="{Loc Key=UI.LyricsPanelView.IncreaseRate}"
                                Classes="iconButton"
                                Command="{Binding IncreaseLyricPlaybackRateCommand}">
                            <LucideIcon Kind="Plus" />
                        </Button>
                    </Grid>
                </Grid>
            </WrapPanel>
            <ListBox x:Name="LyricListBox"
                     Grid.Row="3"
                     Classes="lyricLineList"
                     ItemsSource="{Binding Lyrics}"
                     SelectedItem="{Binding ActiveLyricLine, Mode=OneWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="workspace:LyricLineState">
                        <Border Classes="lyricLine"
                                Classes.active="{Binding IsActive}"
                                Classes.sent="{Binding IsSent}"
                                DoubleTapped="LyricLine_OnDoubleTapped">
                            <Grid>
                                <ProgressBar Classes="lyricLineProgress"
                                             Minimum="0"
                                             Maximum="1"
                                             Value="{Binding Progress}"
                                             IsHitTestVisible="False" />
                                <Grid ColumnDefinitions="56,*"
                                      Margin="0,1">
                                    <TextBlock Text="{Binding Timeline}"
                                               Classes="muted"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                        <TextBlock Text="{Binding Content}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding TranslatedContent}"
                                                   Classes="muted"
                                                   IsVisible="{Binding HasTranslatedContent}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</components:WorkbenchRoomPanel>