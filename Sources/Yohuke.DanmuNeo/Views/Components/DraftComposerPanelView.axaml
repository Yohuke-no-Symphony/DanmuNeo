<components:WorkbenchRoomPanel xmlns="https://github.com/avaloniaui"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:workspace="clr-namespace:Yohuke.DanmuNeo.Models.Workspace"
                               xmlns:state="clr-namespace:Yohuke.DanmuNeo.Models.State"
                               xmlns:components="clr-namespace:Yohuke.DanmuNeo.Views.Components"
                               xmlns:items="clr-namespace:Yohuke.DanmuNeo.ViewModels.Items"
                               x:Class="Yohuke.DanmuNeo.Views.Components.DraftComposerPanelView"
                               x:DataType="items:LiveRoomTabViewModel"
                               x:CompileBindings="True"
                               MinHeight="82"
                               x:Name="Root">
    <components:WorkbenchRoomPanel.Styles>
        <Style Selector="ComboBox.translateComposerColorSelector">
            <Setter Property="SelectionBoxItemTemplate">
                <DataTemplate x:DataType="workspace:DanmuColorOption" DataType="{x:Null}">
                    <Grid Width="26" Height="26" IsHitTestVisible="False">
                        <LucideIcon Kind="Palette" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </Setter>
        </Style>
        <Style Selector="ComboBox.translateComposerModeSelector">
            <Setter Property="SelectionBoxItemTemplate">
                <DataTemplate x:DataType="workspace:DanmuModeOption" DataType="{x:Null}">
                    <Grid Width="26" Height="26" IsHitTestVisible="False">
                        <LucideIcon Kind="MessageSquareText" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </Setter>
        </Style>
    </components:WorkbenchRoomPanel.Styles>
    <Border x:Name="ComposerFrame" Classes="translateComposer"
            Classes.sendFailed="{Binding IsDraftSendFailed}">
        <Grid x:Name="ComposerLayout" RowDefinitions="*,Auto"
              RowSpacing="4">
            <Grid>
                <TextBox x:Name="InputDraftTextBox"
                         Classes="translateComposerInput"
                         MinLines="1"
                         VerticalContentAlignment="Top"
                         Text="{Binding InputDraft}"
                         Watermark="{Loc Key=UI.DraftComposerPanelView.DraftWatermark}"
                         TextWrapping="Wrap"
                         AcceptsReturn="False"
                         KeyDown="InputDraft_OnKeyDown" />
            </Grid>
            <StackPanel x:Name="ComposerFooter" Grid.Row="1" Spacing="4">
                <TextBlock x:Name="DraftSendErrorText"
                           Text="{Binding DraftSendError}"
                           ToolTip.Tip="{Binding DraftSendError}"
                           IsVisible="{Binding IsDraftSendFailed}"
                           Foreground="{DynamicResource AppErrorBrush}"
                           TextWrapping="Wrap" MaxLines="2"
                           TextTrimming="CharacterEllipsis" />
                <components:ComposerToolbarPanel x:Name="ComposerToolbar">
                    <ComboBox x:Name="ComposerMarkSelector"
                              Classes="translateComposerMarkSelector"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding #Root.Context.Application.SymbolGroups}"
                              SelectedItem="{Binding #Root.Context.Application.SelectedWorkspaceMarkGroup}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="state:MarkSymbolGroup">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <WrapPanel x:Name="ComposerActions" Orientation="Horizontal"
                               ItemsAlignment="End" ItemSpacing="4" LineSpacing="4">
                        <Grid x:Name="ComposerColorSelectorHost" VerticalAlignment="Center">
                            <ComboBox x:Name="DanmuColorSelector"
                                      Classes="translateComposerConfigSelector translateComposerColorSelector"
                                      AutomationProperties.Name="{Loc Key=UI.DraftComposerPanelView.Color}"
                                      AutomationProperties.HelpText="{Binding SelectedDanmuColor.Name, FallbackValue=''}"
                                      PlaceholderText="{Loc Key=UI.DraftComposerPanelView.Color}"
                                      IsEnabled="{Binding CanSelectDanmuColor}"
                                      ItemsSource="{Binding DanmuColorOptions}"
                                      SelectedItem="{Binding SelectedDanmuColor, Mode=TwoWay}"
                                      DropDownOpened="DanmuConfigSelector_OnDropDownOpened">
                                <ToolTip.Tip>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding SelectedDanmuColor.Name, FallbackValue=''}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DanmuConfigurationStatus}" />
                                    </StackPanel>
                                </ToolTip.Tip>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="workspace:DanmuColorOption">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                                            <Border Width="10" Height="10" CornerRadius="3"
                                                    BorderThickness="1" BorderBrush="{DynamicResource AppMutedTextBrush}"
                                                    Background="{Binding ColorHex}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Border x:Name="ComposerColorBadge" Width="9" Height="9" CornerRadius="5" Margin="4"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                    Background="{Binding SelectedDanmuColor.ColorHex}" BorderThickness="1"
                                    BorderBrush="{DynamicResource AppTextBrush}"
                                    IsVisible="{Binding SelectedDanmuColor, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </Grid>
                        <Grid x:Name="ComposerModeSelectorHost" VerticalAlignment="Center">
                            <ComboBox x:Name="DanmuModeSelector"
                                      Classes="translateComposerConfigSelector translateComposerModeSelector"
                                      AutomationProperties.Name="{Loc Key=UI.DraftComposerPanelView.Position}"
                                      AutomationProperties.HelpText="{Binding SelectedDanmuMode.Name, FallbackValue=''}"
                                      PlaceholderText="{Loc Key=UI.DraftComposerPanelView.Position}"
                                      IsEnabled="{Binding CanSelectDanmuMode}"
                                      ItemsSource="{Binding DanmuModeOptions}"
                                      SelectedItem="{Binding SelectedDanmuMode, Mode=TwoWay}"
                                      DropDownOpened="DanmuConfigSelector_OnDropDownOpened">
                                <ToolTip.Tip>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding SelectedDanmuMode.Name, FallbackValue=''}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DanmuConfigurationStatus}" />
                                    </StackPanel>
                                </ToolTip.Tip>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="workspace:DanmuModeOption">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Border x:Name="ComposerModeBadge" Width="14" Height="14" CornerRadius="7" Margin="4"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                    Background="{DynamicResource AppCardBrush}"
                                    IsVisible="{Binding SelectedDanmuMode, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <LucideIcon Kind="{Binding SelectedDanmuMode, Converter={x:Static components:DraftComposerPanelView.ModeBadgeIconConverter}}"
                                            Size="11" x:Name="ComposerModeBadgeIcon" />
                            </Border>
                        </Grid>
                        <Button
                            Classes="translateComposerSendButton"
                            ToolTip.Tip="{Loc Key=UI.DraftComposerPanelView.SendTranslation}"
                            Command="{Binding SendDraftCommand}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6">
                                <LucideIcon Kind="Send" />
                                <TextBlock Text="{Loc Key=UI.DraftComposerPanelView.Send}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </components:ComposerToolbarPanel>
            </StackPanel>
        </Grid>
    </Border>
</components:WorkbenchRoomPanel>
