<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:state="clr-namespace:Yohuke.DanmuNeo.Models.State"
             x:Class="Yohuke.DanmuNeo.Views.Components.ShieldReplacementSettingsView"
             x:CompileBindings="False"
             x:Name="Root">
    <StackPanel Spacing="18"
                IsVisible="{Binding IsShieldReplacementSettingsSelected}">
        <Border Classes="panel"
                Padding="14">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <StackPanel>
                        <TextBlock Text="{Loc Key=UI.ShieldReplacementSettingsView.Title}"
                                   Classes="sectionTitle"/>
                        <TextBlock Text="{Loc Key=UI.ShieldReplacementSettingsView.ReplacementHint}"
                                   Classes="muted"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding #Root.AddShieldReplacementRuleCommand}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <LucideIcon Kind="ListPlus"/>
                            <TextBlock Text="{Loc Key=UI.ShieldReplacementSettingsView.AddRule}"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <CheckBox Content="{Loc Key=UI.ShieldReplacementSettingsView.ApplyToLyrics}"
                          IsChecked="{Binding Settings.ApplyShieldReplacementToLyrics}"/>

                <ItemsControl ItemsSource="{Binding ShieldReplacementRules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="state:ShieldReplacementRule">
                            <Border Classes="markGroupCard">
                                <Grid ColumnDefinitions="*,*,Auto,Auto,Auto"
                                      ColumnSpacing="8">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Loc Key=UI.ShieldReplacementSettingsView.MatchText}"
                                                   Classes="muted"/>
                                        <TextBox Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}"
                                                 Watermark="{Loc Key=UI.ShieldReplacementSettingsView.MatchWatermark}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Spacing="4">
                                        <TextBlock Text="{Loc Key=UI.ShieldReplacementSettingsView.ReplacementText}"
                                                   Classes="muted"/>
                                        <TextBox Text="{Binding ReplacementText, UpdateSourceTrigger=PropertyChanged}"
                                                 Watermark="{Loc Key=UI.ShieldReplacementSettingsView.ReplacementWatermark}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Classes="iconButton"
                                            ToolTip.Tip="{Loc Key=UI.ShieldReplacementSettingsView.MoveUp}"
                                            VerticalAlignment="Bottom"
                                            Command="{Binding #Root.MoveShieldReplacementRuleUpCommand}"
                                            CommandParameter="{Binding}">
                                        <LucideIcon Kind="SquareArrowUp"/>
                                    </Button>
                                    <Button Grid.Column="3"
                                            Classes="iconButton"
                                            ToolTip.Tip="{Loc Key=UI.ShieldReplacementSettingsView.MoveDown}"
                                            VerticalAlignment="Bottom"
                                            Command="{Binding #Root.MoveShieldReplacementRuleDownCommand}"
                                            CommandParameter="{Binding}">
                                        <LucideIcon Kind="SquareArrowDown"/>
                                    </Button>
                                    <Button Grid.Column="4"
                                            Classes="iconButton"
                                            ToolTip.Tip="{Loc Key=UI.ShieldReplacementSettingsView.Delete}"
                                            VerticalAlignment="Bottom"
                                            Command="{Binding #Root.DeleteShieldReplacementRuleCommand}"
                                            CommandParameter="{Binding}">
                                        <LucideIcon Kind="Trash2"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
