        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="Grid.compactDanmu components|HoverMarqueeTextBlock.compactFeedContent">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="Grid.compactDanmu.compactDanmuWrap Button.danmuFeedButton TextBlock.regularFeedContent">
