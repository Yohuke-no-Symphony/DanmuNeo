<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Yohuke.DanmuNeo.Views.LyricEditDialogWindow"
        x:CompileBindings="False"
        Width="860"
        Height="560"
        MinWidth="720"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Title="{Loc Key=UI.LyricEditDialogWindow.Title}">
    <Border x:Name="DialogSurface"
            Background="{DynamicResource AppCardBrush}"
            Padding="22">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto"
              RowSpacing="12">
            <StackPanel Spacing="4">
                <TextBlock Text="{Loc Key=UI.LyricEditDialogWindow.Title}"
                           FontSize="22"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Loc Key=UI.LyricEditDialogWindow.SaveHint}"
                           Classes="muted"/>
            </StackPanel>

            <Grid Grid.Row="1"
                  ColumnDefinitions="*,*,*"
                  ColumnSpacing="8">
                <TextBox x:Name="LyricTitleInput"
                         Watermark="{Loc Key=UI.LyricEditDialogWindow.SongTitle}"
                         Text="{Binding Title}"/>
                <TextBox Grid.Column="1"
                         Watermark="{Loc Key=UI.LyricEditDialogWindow.Artist}"
                         Text="{Binding Artist}"/>
                <TextBox Grid.Column="2"
                         Watermark="{Loc Key=UI.LyricEditDialogWindow.Album}"
                         Text="{Binding Album}"/>
            </Grid>

            <TextBox Grid.Row="2"
                     Watermark="{Loc Key=UI.LyricEditDialogWindow.Tags}"
                     Text="{Binding Tags}"/>

            <Border Grid.Row="3"
                    Classes="lyricEditError"
                    IsVisible="{Binding HasError}">
                <TextBlock x:Name="LyricValidationErrorText"
                           Text="{Binding ErrorText}"
                           TextWrapping="Wrap"/>
            </Border>

            <Grid Grid.Row="4"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="10">
                <TextBox x:Name="OriginalLyricTextBox"
                         Watermark="{Loc Key=UI.LyricEditDialogWindow.OriginalLyrics}"
                         Text="{Binding LyricText, Mode=OneTime}"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Menlo, Consolas, Courier New"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                <TextBox Grid.Column="1"
                         x:Name="TranslatedLyricTextBox"
                         Watermark="{Loc Key=UI.LyricEditDialogWindow.TranslatedLyrics}"
                         Text="{Binding TranslatedLyricText, Mode=OneTime}"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Menlo, Consolas, Courier New"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Grid>

            <Grid Grid.Row="5"
                  ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="8">
                <Button Grid.Column="1"
                        Content="{Loc Key=UI.LyricEditDialogWindow.Cancel}"
                        Click="Cancel_OnClick"/>
                <Button x:Name="SaveLyricButton"
                        Grid.Column="2"
                        Classes="primaryButton"
                        Content="{Loc Key=UI.LyricEditDialogWindow.Save}"
                        Click="Save_OnClick"/>
            </Grid>
        </Grid>
    </Border>
</Window>
