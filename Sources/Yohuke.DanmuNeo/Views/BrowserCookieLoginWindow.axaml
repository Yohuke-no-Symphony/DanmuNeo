<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Yohuke.DanmuNeo.Views.BrowserCookieLoginWindow"
        Width="1040"
        Height="760"
        MinWidth="860"
        MinHeight="620"
        Title="{Loc Key=UI.BrowserCookieLoginWindow.Title}">
    <Grid Classes="rootSurface"
          RowDefinitions="Auto,*">
        <Border Classes="browserLoginToolbar">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto"
                  ColumnSpacing="8">
	                <Button ToolTip.Tip="{Loc Key=UI.BrowserCookieLoginWindow.Back}"
	                        Classes="iconButton"
	                        Click="Back_OnClick">
	                    <LucideIcon Kind="CircleArrowLeft"/>
	                </Button>
	                <Button Grid.Column="1"
	                        ToolTip.Tip="{Loc Key=UI.BrowserCookieLoginWindow.Forward}"
	                        Classes="iconButton"
	                        Click="Forward_OnClick">
	                    <LucideIcon Kind="CircleArrowRight"/>
	                </Button>
	                <Button Grid.Column="2"
	                        ToolTip.Tip="{Loc Key=UI.BrowserCookieLoginWindow.Refresh}"
	                        Classes="iconButton"
	                        Click="Refresh_OnClick">
	                    <LucideIcon Kind="RefreshCw"/>
	                </Button>
                <StackPanel Grid.Column="3"
                            Spacing="2"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderText"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText"
                               Classes="muted"/>
                </StackPanel>
	                <Button Grid.Column="4"
	                        Content="{Loc Key=UI.BrowserCookieLoginWindow.Cancel}"
	                        Click="Cancel_OnClick"/>
	                <Button Grid.Column="5"
	                        x:Name="CaptureButton"
	                        Classes="primaryButton"
	                        Click="Capture_OnClick">
	                    <StackPanel Orientation="Horizontal"
	                                Spacing="6">
	                        <LucideIcon Kind="Cookie"/>
	                        <TextBlock Text="{Loc Key=UI.BrowserCookieLoginWindow.CaptureCookies}"/>
	                    </StackPanel>
	                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Classes="browserLoginSurface">
            <Border x:Name="WebViewHost"
                    Classes="browserLoginPlaceholder">
                <TextBlock x:Name="WebViewPlaceholderText"
                           Text="{Loc Key=UI.BrowserCookieLoginWindow.PreparingBrowser}"
                           Classes="muted"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </Border>
    </Grid>
</Window>
