<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:workspace="clr-namespace:Yohuke.DanmuNeo.Models.Workspace"
        xmlns:components="clr-namespace:Yohuke.DanmuNeo.Views.Components"
        x:Class="Yohuke.DanmuNeo.Views.DanmuStylePreviewWindow"
        x:CompileBindings="False"
        Width="1040"
        Height="720"
        MinWidth="820"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Title="{Loc Key=UI.DanmuStylePreviewWindow.Title}">
    <Grid Classes="rootSurface"
          RowDefinitions="Auto,*">
        <Border Classes="panel"
                Margin="16,16,16,0"
                Padding="14,10">
            <Grid RowDefinitions="Auto,Auto"
                  RowSpacing="10">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Loc Key=UI.DanmuStylePreviewWindow.Title}"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Loc Key=UI.DanmuStylePreviewWindow.DebugHint}"
                               Classes="muted"
                               TextWrapping="Wrap" />
                    <StackPanel x:Name="CurrentMarkGroupPanel"
                                IsVisible="False"
                                Orientation="Horizontal"
                                Spacing="6">
                        <TextBlock Text="{Loc Key=UI.DanmuStylePreviewWindow.WorkspacePreset}"
                                   Classes="muted" />
                        <TextBlock x:Name="CurrentMarkGroupText"
                                   Text="{Binding SelectedWorkspaceMarkGroup.Name}"
                                   MaxWidth="180"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
                <WrapPanel Grid.Row="1"
                           Orientation="Horizontal">
                    <CheckBox Content="{Loc Key=UI.DanmuStylePreviewWindow.CompactMode}"
                              IsChecked="{Binding IsCompactDanmuDisplay}"
                              Margin="0,0,16,0"
                              VerticalAlignment="Center" />
                    <CheckBox x:Name="CompactDanmuWrapCheckBox"
                              Content="{Loc Key=UI.DanmuStylePreviewWindow.WrapDanmu}"
                              IsChecked="{Binding IsCompactDanmuWrap}"
                              IsEnabled="{Binding IsCompactDanmuDisplay}"
                              Margin="0,0,16,0"
                              VerticalAlignment="Center" />
                    <CheckBox x:Name="CompactSuperChatWrapCheckBox"
                              Content="{Loc Key=UI.DanmuStylePreviewWindow.WrapSuperChat}"
                              IsChecked="{Binding IsCompactSuperChatWrap}"
                              IsEnabled="{Binding IsCompactDanmuDisplay}"
                              Margin="0,0,16,0"
                              VerticalAlignment="Center" />
                    <TextBlock Text="{Loc Key=UI.DanmuStylePreviewWindow.Theme}"
                               Classes="muted"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="ThemeModeComboBox"
                              Width="120"
                              SelectionChanged="ThemeMode_OnSelectionChanged">
                        <ComboBoxItem Content="{Loc Key=UI.DanmuStylePreviewWindow.SystemTheme}" />
                        <ComboBoxItem Content="{Loc Key=UI.DanmuStylePreviewWindow.LightTheme}" />
                        <ComboBoxItem Content="{Loc Key=UI.DanmuStylePreviewWindow.DarkTheme}" />
                    </ComboBox>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="300" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Border Classes="panel"
                    Padding="14">
                <Grid Classes.compactDanmu="{Binding IsCompactDanmuDisplay}"
                      Classes.compactDanmuWrap="{Binding IsCompactDanmuWrap}"
                      Classes.compactSuperChatWrap="{Binding IsCompactSuperChatWrap}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="35*" MinHeight="110" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="65*" MinHeight="180" />
                    </Grid.RowDefinitions>

                    <Grid ColumnDefinitions="*,Auto"
                          Margin="0,0,0,10">
                        <TextBlock Text="{Loc Key=UI.DanmuStylePreviewWindow.ProductionPreview}"
                                   Classes="sectionTitle" />
                        <TextBlock Grid.Column="1"
                                   Text="{Loc Key=UI.DanmuStylePreviewWindow.FeedRatio}"
                                   Classes="muted" />
                    </Grid>

                    <ListBox Grid.Row="1"
                             Classes="feedList"
                             ItemsSource="{Binding SuperChats}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="workspace:SuperChatItem">
                                <Button Classes="scFeedButton"
                                        Classes.guardPurchase="{Binding IsGuardPurchase}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Click="SuperChat_OnClick">
                                    <Border Classes="scFeedCard"
                                            BorderThickness="2">
                                        <Border.BorderBrush>
                                            <SolidColorBrush Color="{Binding BorderColor}" />
                                        </Border.BorderBrush>
                                        <Grid Classes="scFeedLayout"
                                              RowDefinitions="Auto,Auto">
                                            <Grid ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="8">
                                                <StackPanel Spacing="1">
                                                    <Button Classes="feedUserNameButton"
                                                            Click="FeedUserName_OnClick">
                                                        <TextBlock Text="{Binding UserName}"
                                                                   Classes="danmuFeedUser"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Button>
                                                    <TextBlock Text="{Binding DisplayTime}"
                                                               Classes="danmuFeedMeta" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding BadgeText}"
                                                           Classes="scFeedPrice"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Foreground>
                                                        <SolidColorBrush Color="{Binding BorderColor}" />
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                            </Grid>
                                            <Grid Grid.Row="1"
                                                  Classes="scFeedContent"
                                                  IsVisible="{Binding CanInsertContent}">
                                                <TextBlock Text="{Binding Content}"
                                                           Classes="danmuFeedContent regularFeedContent"
                                                           TextWrapping="Wrap" />
                                                <components:HoverMarqueeTextBlock Text="{Binding Content}"
                                                                                  Classes="compactFeedContent" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <GridSplitter Grid.Row="2"
                                  Height="4"
                                  HorizontalAlignment="Stretch"
                                  ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext" />

                    <ScrollViewer x:Name="DanmuScrollViewer"
                                  Grid.Row="3"
                                  Margin="0,6,0,0">
                        <ItemsControl x:Name="DanmuItemsControl"
                                      Classes="scrollSafeContent danmuFeedList"
                                      ItemsSource="{Binding DanmuItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="workspace:DanmuFeedItem">
                                    <Button Classes="danmuFeedButton"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch">
                                        <Grid Classes="danmuFeedLayout"
                                              ColumnDefinitions="2*,3*"
                                              RowDefinitions="Auto">
                                            <DockPanel Classes="danmuFeedIdentity"
                                                       VerticalAlignment="Center">
                                                <Border Classes="danmuMedalBadge"
                                                        BorderBrush="{Binding MedalBorderBrush}"
                                                        IsVisible="{Binding HasMedal}"
                                                        ToolTip.Tip="{Binding MedalText}">
                                                    <Grid Classes="danmuMedalLayout"
                                                          ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding MedalDisplayName}"
                                                                   Classes="danmuMedalText danmuMedalName"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding MedalLevel}"
                                                                   Classes="danmuMedalText danmuMedalLevel"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding DetailLine}"
                                                           Classes="danmuFeedMeta"
                                                           DockPanel.Dock="Right"
                                                           Margin="6,0,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Button Classes="feedUserNameButton"
                                                        Click="FeedUserName_OnClick">
                                                    <TextBlock Text="{Binding UserName}"
                                                               Classes="danmuFeedUser"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Button>
                                            </DockPanel>
                                            <components:EmoticonTextBlock Grid.Column="1"
                                                                         ContentText="{Binding Content}"
                                                                         Emoticons="{Binding Emoticons}"
                                                                         Classes="danmuFeedContent regularFeedContent"
                                                                         TextWrapping="Wrap" />
                                            <components:HoverMarqueeTextBlock Grid.Column="1"
                                                                              Text="{Binding Content}"
                                                                              Emoticons="{Binding Emoticons}"
                                                                              Classes="compactFeedContent" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          Classes="workspaceSplitter"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" />

            <Border Grid.Column="2"
                    Classes="panel"
                    Margin="12,0,0,0"
                    Padding="16">
                <ScrollViewer>
                    <StackPanel Classes="scrollSafeContent"
                                Spacing="12">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Loc Key=UI.DanmuStylePreviewWindow.TestData}"
                                       Classes="sectionTitle" />
                            <TextBlock Text="{Loc Key=UI.DanmuStylePreviewWindow.TestDataHint}"
                                       Classes="muted"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="{Loc Key=UI.DanmuStylePreviewWindow.UserName}"
                                       Classes="muted" />
                            <TextBox Text="{Binding UserName}"
                                     Watermark="{Loc Key=UI.DanmuStylePreviewWindow.UserNameWatermark}" />
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="{Loc Key=UI.DanmuStylePreviewWindow.Content}"
                                       Classes="muted" />
                            <TextBox Text="{Binding Content}"
                                     Watermark="{Loc Key=UI.DanmuStylePreviewWindow.ContentWatermark}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="92" />
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="{Loc Key=UI.DanmuStylePreviewWindow.OptionalDanmuStatus}"
                                       Classes="muted" />
                            <TextBox Text="{Binding DanmuStatus}"
                                     Watermark="{Loc Key=UI.DanmuStylePreviewWindow.StatusWatermark}" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,120"
                              ColumnSpacing="8">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Loc Key=UI.DanmuStylePreviewWindow.OptionalMedalName}"
                                           Classes="muted" />
                                <TextBox Text="{Binding MedalName}"
                                         Watermark="{Loc Key=UI.DanmuStylePreviewWindow.MedalWatermark}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Spacing="5">
                                <TextBlock Text="{Loc Key=UI.DanmuStylePreviewWindow.MedalLevel}"
                                           Classes="muted" />
                                <NumericUpDown Value="{Binding MedalLevel}"
                                               Minimum="0"
                                               Maximum="2147483647"
                                               Increment="1"
                                               FormatString="0" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="5">
                            <TextBlock Text="{Loc Key=UI.DanmuStylePreviewWindow.MedalGuardLevel}"
                                       Classes="muted" />
                            <ComboBox ItemsSource="{Binding MedalGuardPresets}"
                                      SelectedItem="{Binding SelectedMedalGuardPreset}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="workspace:GuardStylePreset">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="8">
                            <Button Classes="primaryButton"
                                    Content="{Loc Key=UI.DanmuStylePreviewWindow.AddDanmu}"
                                    Click="AddDanmu_OnClick" />
                            <Button Grid.Column="1"
                                    Content="{Loc Key=UI.DanmuStylePreviewWindow.AddBatch}"
                                    Click="AddDanmuBatch_OnClick" />
                        </Grid>
                        <TextBlock Text="{Loc Key=UI.DanmuStylePreviewWindow.ScrollHint}"
                                   Classes="muted"
                                   TextWrapping="Wrap" />

                        <Border Classes="historyRecordCard"
                                Margin="0,4,0,0">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Loc Key=UI.DanmuStylePreviewWindow.SuperChatSettings}"
                                           FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding SuperChatPresets}"
                                          SelectedItem="{Binding SelectedSuperChatPreset}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,*"
                                                  ColumnSpacing="8">
                                                <Border Width="14"
                                                        Height="14"
                                                        CornerRadius="7"
                                                        VerticalAlignment="Center">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{Binding BorderColor}" />
                                                    </Border.Background>
                                                </Border>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayName}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Loc Key=UI.DanmuStylePreviewWindow.BorderColor}"
                                               Classes="muted" />
                                    <TextBox Text="{Binding SuperChatColorText}"
                                             Watermark="#3171D2" />
                                </StackPanel>
                                <Button Classes="primaryButton"
                                        Content="{Loc Key=UI.DanmuStylePreviewWindow.AddSuperChat}"
                                        Click="AddSuperChat_OnClick" />
                            </StackPanel>
                        </Border>

                        <Border Classes="historyRecordCard">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Loc Key=UI.DanmuStylePreviewWindow.GuardSettings}"
                                           FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding GuardPresets}"
                                          SelectedItem="{Binding SelectedGuardPreset}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="workspace:GuardStylePreset">
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Classes="primaryButton"
                                        Content="{Loc Key=UI.DanmuStylePreviewWindow.AddGuardPurchase}"
                                        Click="AddGuardPurchase_OnClick" />
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="8">
                            <Button Content="{Loc Key=UI.DanmuStylePreviewWindow.ResetSamples}"
                                    Click="ResetSamples_OnClick" />
                            <Button Grid.Column="1"
                                    Content="{Loc Key=UI.DanmuStylePreviewWindow.ClearList}"
                                    Click="ClearSamples_OnClick" />
                        </Grid>

                        <TextBlock Text="{Loc Key=UI.DanmuStylePreviewWindow.PriceHint}"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
