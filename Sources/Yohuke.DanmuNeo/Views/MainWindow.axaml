<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:Yohuke.DanmuNeo.ViewModels"
        xmlns:items="clr-namespace:Yohuke.DanmuNeo.ViewModels.Items"
        xmlns:components="clr-namespace:Yohuke.DanmuNeo.Views.Components"
        x:Class="Yohuke.DanmuNeo.Views.MainWindow"
        x:DataType="viewModels:MainWindowViewModel"
        x:CompileBindings="True"
        Width="1280" Height="820" MinWidth="980" MinHeight="640"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="42"
        Icon="/Assets/favicon.ico"
        Title="{Binding WindowTitle}">
    <Grid Classes="rootSurface" RowDefinitions="42,Auto,*">
        <components:TitleBarView>
            <components:TitleBarView.MenuContent>
                <Menu x:Name="WindowMenu" Classes="workbenchMenu" />
            </components:TitleBarView.MenuContent>
        </components:TitleBarView>
        <Border Grid.Row="1" Padding="14,8" DataContext="{Binding SelectedWorkspace.SelectedRoom}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" x:DataType="items:LiveRoomTabViewModel">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Classes="listenStatusLight"
                            Classes.listening="{Binding IsListening}"
                            Classes.idle="{Binding IsNotListening}"
                            ToolTip.Tip="{Binding ConnectionStatus}" />
                    <TextBlock Text="{Binding RoomName}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding RoomId}" Classes="muted" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="ListenToggleButton" Grid.Column="1"
                        Classes="listenToggleButton"
                        Classes.listening="{Binding IsListening}"
                        Classes.idle="{Binding IsNotListening}"
                        Command="{Binding ToggleListeningCommand}"
                        ToolTip.Tip="{Binding ConnectionStatus}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <LucideIcon Kind="Radio" IsVisible="{Binding IsNotListening}" />
                        <LucideIcon Kind="CircleStop" IsVisible="{Binding IsListening}" />
                        <TextBlock Text="{Binding ListenToggleText}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
        <ContentControl x:Name="DockHost" Grid.Row="2" Margin="12,0,12,12">
            <TextBlock Text="正在恢复工作台布局…" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </ContentControl>
    </Grid>
</Window>
