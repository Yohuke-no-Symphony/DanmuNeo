<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:Yohuke.DanmuNeo.ViewModels"
        xmlns:components="clr-namespace:Yohuke.DanmuNeo.Views.Components"
        x:Class="Yohuke.DanmuNeo.Views.MainWindow"
        x:DataType="viewModels:MainWindowViewModel"
        x:CompileBindings="True"
        Width="1280" Height="820" MinWidth="980" MinHeight="640"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="{x:Static components:WindowTitleBar.DEFAULT_HEIGHT}"
        Icon="/Assets/favicon.ico"
        Title="{Binding WindowTitle}">
    <Grid Classes="rootSurface" RowDefinitions="Auto,*">
        <components:TitleBarView x:Name="MainTitleBar">
            <components:TitleBarView.MenuContent>
                <Menu x:Name="WindowMenu" Classes="workbenchMenu" />
            </components:TitleBarView.MenuContent>
        </components:TitleBarView>
        <ContentControl x:Name="DockHost" Grid.Row="1" Margin="12,0,12,12">
            <TextBlock Text="正在恢复工作台布局…" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </ContentControl>
    </Grid>
</Window>
